<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FilesMate.App.Controls.InfoStates.InfoStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel
        MaxWidth="420"
        Padding="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="12">
        <FontIcon
            x:Name="GlyphIcon"
            HorizontalAlignment="Center"
            FontFamily="Segoe Fluent Icons"
            FontSize="32"
            Glyph="&#xE8B7;" />
        <TextBlock
            x:Name="TitleBlock"
            HorizontalAlignment="Center"
            Style="{StaticResource SubtitleTextBlockStyle}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="BodyBlock"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"
            Style="{StaticResource BodyTextBlockStyle}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
        <StackPanel
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                x:Name="PrimaryAction"
                Click="PrimaryAction_Click"
                Style="{StaticResource PillButtonStyle}"
                Visibility="Collapsed" />
            <Button
                x:Name="SecondaryAction"
                Click="SecondaryAction_Click"
                Style="{StaticResource GlassButtonStyle}"
                Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</UserControl>
