<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FilesMate.App.Controls.FileSurface.FileTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="80"
    Height="88"
    IsTabStop="False">
    <Border
        x:Name="Root"
        Padding="2"
        HorizontalAlignment="Center"
        VerticalAlignment="Top"
        Background="Transparent"
        BorderBrush="Transparent"
        BorderThickness="0"
        CornerRadius="{StaticResource FilesMate.Corner.Card}"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited"
        PointerPressed="OnPointerPressed"
        PointerReleased="OnPointerReleased"
        PointerCaptureLost="OnPointerCaptureLost">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Normal">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="Transparent" />
                        <Setter Target="Root.BorderBrush" Value="Transparent" />
                        <Setter Target="Root.BorderThickness" Value="0" />
                        <Setter Target="Root.Padding" Value="2" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource FilesMate.Item.HoverBrush}" />
                        <Setter Target="Root.BorderBrush" Value="{ThemeResource FilesMate.Glass.BorderBrush}" />
                        <Setter Target="Root.BorderThickness" Value="1" />
                        <Setter Target="Root.Padding" Value="1" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource FilesMate.Item.SelectedBrush}" />
                        <Setter Target="Root.BorderBrush" Value="{ThemeResource FilesMate.Glass.BorderStrongBrush}" />
                        <Setter Target="Root.BorderThickness" Value="1" />
                        <Setter Target="Root.Padding" Value="1" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource FilesMate.Item.SelectedBrush}" />
                        <Setter Target="Root.BorderBrush" Value="{ThemeResource FilesMate.Glass.BorderBrush}" />
                        <Setter Target="Root.BorderThickness" Value="1" />
                        <Setter Target="Root.Padding" Value="1" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectedPointerOver">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource FilesMate.Item.SelectedHoverBrush}" />
                        <Setter Target="Root.BorderBrush" Value="{ThemeResource FilesMate.Glass.BorderStrongBrush}" />
                        <Setter Target="Root.BorderThickness" Value="1" />
                        <Setter Target="Root.Padding" Value="1" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectedPressed">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource FilesMate.Item.SelectedBrush}" />
                        <Setter Target="Root.BorderBrush" Value="{ThemeResource FilesMate.Glass.BorderStrongBrush}" />
                        <Setter Target="Root.BorderThickness" Value="1" />
                        <Setter Target="Root.Padding" Value="1" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Focused">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="Transparent" />
                        <Setter Target="Root.BorderBrush" Value="{ThemeResource FilesMate.Selection.AccentBrush}" />
                        <Setter Target="Root.BorderThickness" Value="1" />
                        <Setter Target="Root.Padding" Value="1" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Dragging">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource FilesMate.Item.SelectedBrush}" />
                        <Setter Target="Root.BorderBrush" Value="{ThemeResource FilesMate.Selection.AccentBrush}" />
                        <Setter Target="Root.BorderThickness" Value="2" />
                        <Setter Target="Root.Padding" Value="0" />
                        <Setter Target="Root.Opacity" Value="0.55" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DropTarget">
                    <VisualState.Setters>
                        <Setter Target="Root.Background" Value="{ThemeResource FilesMate.Item.DropTargetBrush}" />
                        <Setter Target="Root.BorderBrush" Value="{ThemeResource FilesMate.Selection.AccentBrush}" />
                        <Setter Target="Root.BorderThickness" Value="2" />
                        <Setter Target="Root.Padding" Value="0" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                x:Name="IconHost"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                UseLayoutRounding="True"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="{StaticResource FilesMate.Corner.Card}">
                <Grid>
                    <FontIcon
                        x:Name="Glyph"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="32"
                        Glyph="&#xE8B7;" />
                    <Image
                        x:Name="IconImage"
                        Stretch="Uniform"
                        UseLayoutRounding="True"
                        Visibility="Collapsed" />
                    <Viewbox Stretch="Uniform" IsHitTestVisible="False">
                        <Grid x:Name="FolderPreviewHost" Width="128" Height="128" Visibility="Collapsed">
                            <Border
                                Margin="21,43,20,22"
                                Background="{ThemeResource FilesMate.FolderPreview.BodyBrush}"
                                BorderBrush="{ThemeResource FilesMate.FolderPreview.TabBrush}"
                                BorderThickness="2"
                                CornerRadius="6">
                                <Image
                                    x:Name="FolderPreviewCover"
                                    Stretch="UniformToFill"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch" />
                            </Border>
                        </Grid>
                    </Viewbox>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="0,2,0,0" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="NameText"
                    HorizontalAlignment="Center"
                    MaxLines="2"
                    Style="{StaticResource FileTileNameStyle}" />
                <StackPanel
                    x:Name="TagHost"
                    Grid.Row="1"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
