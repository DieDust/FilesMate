<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FilesMate.App.Controls.FileSurface.FileRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="{StaticResource FilesMate.Control.Height.Row}"
    HorizontalAlignment="Left"
    IsTabStop="False"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    PointerPressed="OnPointerPressed"
    PointerReleased="OnPointerReleased"
    PointerCaptureLost="OnPointerCaptureLost">
    <!--
        Background must be non-null: WinUI only hit-tests panels that paint something, so
        without it the blank stretches between columns fall through to the surface and the
        row loses PointerOver as soon as the cursor leaves a text cell.
    -->
    <Grid
        x:Name="Root"
        Margin="12,1,16,1"
        Background="Transparent"
        BorderThickness="0"
        CornerRadius="{StaticResource FilesMate.Corner.Small}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="Normal">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="Transparent" />
                        <Setter Target="AccentBar.Opacity" Value="0" />
                        <Setter Target="Fill.BorderThickness" Value="0" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerOver">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource FilesMate.Item.HoverBrush}" />
                        <Setter Target="AccentBar.Opacity" Value="0" />
                        <Setter Target="Fill.BorderBrush" Value="{ThemeResource FilesMate.Glass.BorderBrush}" />
                        <Setter Target="Fill.BorderThickness" Value="1" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Pressed">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource FilesMate.Item.SelectedBrush}" />
                        <Setter Target="AccentBar.Opacity" Value="0" />
                        <Setter Target="Fill.BorderBrush" Value="{ThemeResource FilesMate.Glass.BorderStrongBrush}" />
                        <Setter Target="Fill.BorderThickness" Value="1" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Selected">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource FilesMate.Item.SelectedBrush}" />
                        <Setter Target="AccentBar.Opacity" Value="1" />
                        <Setter Target="Fill.BorderBrush" Value="{ThemeResource FilesMate.Glass.BorderBrush}" />
                        <Setter Target="Fill.BorderThickness" Value="1" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectedPointerOver">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource FilesMate.Item.SelectedHoverBrush}" />
                        <Setter Target="AccentBar.Opacity" Value="1" />
                        <Setter Target="Fill.BorderBrush" Value="{ThemeResource FilesMate.Glass.BorderStrongBrush}" />
                        <Setter Target="Fill.BorderThickness" Value="1" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="SelectedPressed">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource FilesMate.Item.SelectedBrush}" />
                        <Setter Target="AccentBar.Opacity" Value="1" />
                        <Setter Target="Fill.BorderBrush" Value="{ThemeResource FilesMate.Glass.BorderStrongBrush}" />
                        <Setter Target="Fill.BorderThickness" Value="1" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Focused">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="Transparent" />
                        <Setter Target="AccentBar.Opacity" Value="0" />
                        <Setter Target="Fill.BorderBrush" Value="{ThemeResource FilesMate.Selection.AccentBrush}" />
                        <Setter Target="Fill.BorderThickness" Value="1" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Dragging">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource FilesMate.Item.SelectedBrush}" />
                        <Setter Target="AccentBar.Opacity" Value="1" />
                        <Setter Target="Fill.BorderThickness" Value="0" />
                        <Setter Target="Root.Opacity" Value="0.55" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DropTarget">
                    <VisualState.Setters>
                        <Setter Target="Fill.Background" Value="{ThemeResource FilesMate.Item.DropTargetBrush}" />
                        <Setter Target="AccentBar.Opacity" Value="1" />
                        <Setter Target="Fill.BorderBrush" Value="{ThemeResource FilesMate.Selection.AccentBrush}" />
                        <Setter Target="Fill.BorderThickness" Value="1" />
                        <Setter Target="Root.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource FilesMate.Column.Accent}" />
            <ColumnDefinition Width="{StaticResource FilesMate.Column.Glyph}" />
            <ColumnDefinition x:Name="NameColumn" Width="{StaticResource FilesMate.Column.Name}" />
            <ColumnDefinition x:Name="ModifiedColumn" Width="{StaticResource FilesMate.Column.Modified}" />
            <ColumnDefinition x:Name="TypeColumn" Width="{StaticResource FilesMate.Column.Type}" />
            <ColumnDefinition x:Name="SizeColumn" Width="{StaticResource FilesMate.Column.Size}" />
        </Grid.ColumnDefinitions>
        <!-- Draw state borders independently of the fixed-width content columns. -->
        <Border
            x:Name="Fill"
            Grid.ColumnSpan="6"
            Background="Transparent"
            CornerRadius="{StaticResource FilesMate.Corner.Small}"
            IsHitTestVisible="False" />
        <Border
            x:Name="AccentBar"
            Width="3"
            Margin="0,4"
            Opacity="0"
            VerticalAlignment="Stretch"
            Background="{ThemeResource FilesMate.Selection.AccentBrush}"
            CornerRadius="1.5"
            IsHitTestVisible="False" />
        <Border
            x:Name="IconFrame"
            Grid.Column="1"
            Width="{StaticResource FilesMate.Icon.Size.Medium}"
            Height="{StaticResource FilesMate.Icon.Size.Medium}"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            UseLayoutRounding="True">
            <Grid>
                <FontIcon
                    x:Name="Glyph"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    Glyph="&#xE8A5;" />
                <Image
                    x:Name="IconImage"
                    Width="{StaticResource FilesMate.Icon.Size.Medium}"
                    Height="{StaticResource FilesMate.Icon.Size.Medium}"
                    Stretch="Uniform"
                    UseLayoutRounding="True"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
        <Grid x:Name="NameCell" Grid.Column="2" Padding="4,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="NameText"
                VerticalAlignment="Center"
                TextWrapping="NoWrap"
                Foreground="{ThemeResource FilesMate.Text.PrimaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
            <StackPanel
                x:Name="TagHost"
                Grid.Column="1"
                Margin="8,0,0,0"
                Orientation="Horizontal"
                Spacing="4" />
        </Grid>
        <TextBlock
            x:Name="ModifiedText"
            Grid.Column="3"
            Padding="8,0,8,0"
            VerticalAlignment="Center"
            Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextTrimming="CharacterEllipsis"
            Typography.NumeralAlignment="Tabular" />
        <TextBlock
            x:Name="TypeText"
            Grid.Column="4"
            Padding="8,0,8,0"
            VerticalAlignment="Center"
            Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            TextTrimming="CharacterEllipsis" />
        <TextBlock
            x:Name="SizeText"
            Grid.Column="5"
            Padding="8,0,8,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Typography.NumeralAlignment="Tabular" />
    </Grid>
</UserControl>
