<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FilesMate.App.Controls.FileSurface.FilePaneChrome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:info="using:FilesMate.App.Controls.InfoStates">
    <UserControl.Resources>
        <StaticResource x:Key="FilePane.ActiveBrush" ResourceKey="FilesMate.FileArea.BackgroundBrush" />
        <StaticResource x:Key="FilePane.InactiveBrush" ResourceKey="FilesMate.FileArea.InactiveBackgroundBrush" />
    </UserControl.Resources>
    <Grid x:Name="Root">
        <Border
            x:Name="PaneCard"
            Margin="8,0,8,0"
            Background="{ThemeResource FilesMate.FileContent.BackgroundBrush}"
            BorderBrush="{ThemeResource FilesMate.FileContent.BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource FilesMate.Corner.Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid x:Name="PaneCaptionHost" Canvas.ZIndex="1" Visibility="Collapsed" Padding="12,6" ColumnSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B7;" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"/>
                    <TextBlock x:Name="PaneCaption" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"/>
                </Grid>
                <Border
                    x:Name="InactiveOverlay"
                    Grid.RowSpan="2"
                    Background="{ThemeResource FilesMate.FileArea.InactiveBackgroundBrush}"
                    CornerRadius="{StaticResource FilesMate.Corner.Card}"
                    IsHitTestVisible="False"
                    Opacity="0" />
                <ContentPresenter
                    x:Name="BodyPresenter"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
                <info:LoadingPresenter x:Name="LoadingHost" Grid.Row="1" VerticalAlignment="Top" />
                <Grid x:Name="InfoViewport" Grid.Row="1" SizeChanged="InfoViewport_SizeChanged">
                    <info:InfoStateView
                        x:Name="Info"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        PrimaryClicked="Info_PrimaryClicked"
                        SecondaryClicked="Info_SecondaryClicked"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
