<UserControl
    x:Class="FilesMate.App.Controls.Favorites.FavoriteGroupPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FilesMate.App.Localization">
    <UserControl.Resources>
        <x:Double x:Key="TreeViewItemMinHeight">34</x:Double>
        <Thickness x:Key="TreeViewItemPresenterMargin">2,1</Thickness>
        <Thickness x:Key="TreeViewItemPresenterPadding">0,4</Thickness>
    </UserControl.Resources>
    <StackPanel Spacing="6">
        <Button x:Name="LocationButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                Padding="10,8" CornerRadius="6" Click="Location_Click"
                AutomationProperties.AutomationId="FavoriteLocationToggle">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock x:Name="SelectedName" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SelectedParent" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <FontIcon x:Name="LocationChevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="10"/>
            </Grid>
        </Button>
        <Border x:Name="Browser" Visibility="Collapsed" CornerRadius="6" Padding="4"
                BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Background="{ThemeResource SubtleFillColorTransparentBrush}">
            <StackPanel Spacing="4">
                <TreeView x:Name="GroupTree" SelectionMode="Single" MaxHeight="210" MinHeight="36"
                          CanDragItems="False" CanReorderItems="False" AllowDrop="False"
                          Expanding="GroupTree_Expanding" SelectionChanged="GroupTree_SelectionChanged"
                          AutomationProperties.Name="{loc:LocalizedText Key=Favorites_Group}"
                          AutomationProperties.AutomationId="FavoriteGroupTree">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="CornerRadius" Value="5"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding Content.Name}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Padding="0,0,6,0" ToolTipService.ToolTip="{Binding Content.Breadcrumb}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Content.Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <Border Height="1" Margin="6,2" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                <Button x:Name="NewGroupButton" Padding="8,5" Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="NewGroup_Click"
                        AutomationProperties.AutomationId="FavoriteLocationNewGroup">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="12"/>
                        <TextBlock Text="{loc:LocalizedText Key=Favorites_NewGroupMenu}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <StackPanel x:Name="NameEditor" Visibility="Collapsed" Spacing="6" Margin="6,2,6,4">
                    <TextBlock x:Name="NewGroupParent" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBox x:Name="NewGroupName" MaxLength="120" PlaceholderText="{loc:LocalizedText Key=NewGroupName}"
                             AutomationProperties.AutomationId="FavoriteLocationGroupName" KeyDown="NewGroupName_KeyDown"/>
                    <TextBlock x:Name="ErrorText" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <Button x:Name="CreateButton" Content="{loc:LocalizedText Key=Confirm}" Click="Create_Click" MinWidth="64" Padding="10,4" AutomationProperties.AutomationId="FavoriteLocationCreate"/>
                        <Button x:Name="CancelButton" Content="{loc:LocalizedText Key=Cancel}" Click="Cancel_Click" MinWidth="64" Padding="10,4"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
