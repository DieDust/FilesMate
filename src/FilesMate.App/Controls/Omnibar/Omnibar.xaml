<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FilesMate.App.Controls.Omnibar.Omnibar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FilesMate.App.Controls"
    xmlns:glass="using:FilesMate.App.Controls.Glass"
    xmlns:local="using:FilesMate.App.Controls.Omnibar"
    SizeChanged="Root_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="SearchActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Foreground" Value="{ThemeResource FilesMate.Text.PrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionFill" Background="Transparent"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ActionFill.Background" Value="{ThemeResource FilesMate.Item.HoverBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ActionFill.Background" Value="{ThemeResource FilesMate.Item.SelectedBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ActionFill.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchScopeSelectedItemStyle" TargetType="Button"
            BasedOn="{StaticResource FilesMate.ContextMenuItemStyle}">
            <Setter Property="Background" Value="{ThemeResource FilesMate.Menu.ItemSelectedBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource FilesMate.Menu.ItemSelectedForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="SelectedRoot" Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="SelectedContent" Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />
                        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver"><VisualState.Setters>
                                <Setter Target="SelectedRoot.Background" Value="{ThemeResource FilesMate.Menu.ItemSelectedHoverBrush}" />
                                <Setter Target="SelectedContent.Foreground" Value="{ThemeResource FilesMate.Menu.ItemSelectedForegroundBrush}" />
                            </VisualState.Setters></VisualState>
                            <VisualState x:Name="Pressed"><VisualState.Setters>
                                <Setter Target="SelectedRoot.Background" Value="{ThemeResource FilesMate.Menu.ItemSelectedPressedBrush}" />
                                <Setter Target="SelectedContent.Foreground" Value="{ThemeResource FilesMate.Menu.ItemSelectedForegroundBrush}" />
                            </VisualState.Setters></VisualState>
                            <VisualState x:Name="Disabled"><VisualState.Setters>
                                <Setter Target="SelectedRoot.Opacity" Value="0.5" />
                                <Setter Target="SelectedContent.Foreground" Value="{ThemeResource FilesMate.Text.DisabledBrush}" />
                            </VisualState.Setters></VisualState>
                        </VisualStateGroup></VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid
        x:Name="RootGrid"
        VisualStateManager.CustomVisualStateManager="{StaticResource FilesMate.Motion.VisualStateManager}"
        MinHeight="{StaticResource FilesMate.Control.Height.Omnibar}"
        ColumnSpacing="{StaticResource FilesMate.Space.2}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="Modes">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="{StaticResource FilesMate.Motion.Standard}" />
                </VisualStateGroup.Transitions>
                <VisualState x:Name="PathDisplay">
                    <VisualState.Setters>
                        <Setter Target="Crumbs.Opacity" Value="1" />
                        <Setter Target="Crumbs.IsHitTestVisible" Value="True" />
                        <Setter Target="PathBox.Opacity" Value="0" />
                        <Setter Target="PathBox.Visibility" Value="Collapsed" />
                        <Setter Target="PathBox.IsHitTestVisible" Value="False" />
                        <Setter Target="PathBox.IsTabStop" Value="False" />
                        <Setter Target="PathEditSurface.Visibility" Value="Visible" />
                        <Setter Target="PathEditSurface.IsHitTestVisible" Value="True" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PathEdit">
                    <VisualState.Setters>
                        <Setter Target="Crumbs.Opacity" Value="0" />
                        <Setter Target="Crumbs.IsHitTestVisible" Value="False" />
                        <Setter Target="SelectionLocationLabel.Opacity" Value="0" />
                        <Setter Target="RecursiveRootCue.Opacity" Value="0" />
                        <Setter Target="PathBox.Opacity" Value="1" />
                        <Setter Target="PathBox.Visibility" Value="Visible" />
                        <Setter Target="PathBox.IsHitTestVisible" Value="True" />
                        <Setter Target="PathBox.IsTabStop" Value="True" />
                        <Setter Target="PathEditSurface.Visibility" Value="Collapsed" />
                        <Setter Target="PathEditSurface.IsHitTestVisible" Value="False" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="160" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <controls:NavigationToolbar
            x:Name="Toolbar"
            VerticalAlignment="Center"
            BackClicked="Toolbar_BackClicked"
            ForwardClicked="Toolbar_ForwardClicked"
            RefreshClicked="Toolbar_RefreshClicked"
            UpClicked="Toolbar_UpClicked" />
        <glass:LiquidGlassSurface
            x:Name="PathHost"
            Grid.Column="1"
            Tapped="PathHost_Tapped"
            MinHeight="38"
            Padding="12,0"
            VerticalAlignment="Center"
            Background="{ThemeResource FilesMate.AddressBar.BackgroundBrush}"
            BorderBrush="{ThemeResource FilesMate.AddressBar.BorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource FilesMate.Corner.Omnibar}"
            Shadow="{x:Null}"
            SurfaceKind="Command"
            Style="{StaticResource FilesMate.LiquidGlassSurfaceStyle}">
            <Grid x:Name="PathViewport" ColumnSpacing="0" SizeChanged="PathViewport_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectionLocationLabel" Grid.Column="0" Visibility="Collapsed"
                    VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" IsHitTestVisible="False"
                    Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                <TextBlock x:Name="RecursiveRootCue" Grid.Column="2" Visibility="Collapsed" MaxWidth="64"
                    VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" TextTrimming="CharacterEllipsis"
                    Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                <StackPanel
                    x:Name="Crumbs"
                    KeyDown="CrumbFolder_KeyDown"
                    Grid.Column="1"
                    Canvas.ZIndex="10"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
                <Border
                    x:Name="PathEditSurface"
                    Grid.ColumnSpan="3"
                    MinWidth="24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Canvas.ZIndex="5"
                    IsHitTestVisible="True"
                    PointerPressed="PathEditSurface_PointerPressed"
                    Visibility="Visible" />
                <TextBox
                    x:Name="PathBox"
                    Visibility="Collapsed"
                    Grid.ColumnSpan="3"
                    Canvas.ZIndex="20"
                    VerticalAlignment="Center"
                    Background="{ThemeResource FilesMate.TextControl.CaretHostBrush}"
                    BorderThickness="0"
                    IsTabStop="False"
                    IsHitTestVisible="False"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    KeyDown="PathBox_KeyDown"
                    LostFocus="PathBox_LostFocus"
                    Padding="10,7,0,0"
                    HorizontalContentAlignment="Left"
                    VerticalContentAlignment="Center"
                    Foreground="{ThemeResource FilesMate.Text.PrimaryBrush}"
                    Opacity="0">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonForeground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessPointerOver">0</Thickness>
                    </TextBox.Resources>
                </TextBox>
            </Grid>
        </glass:LiquidGlassSurface>
        <Grid
            x:Name="SearchCluster"
            Grid.Column="2"
            VerticalAlignment="Center">
            <Grid
                x:Name="SearchSizer"
                Width="240"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
            <glass:LiquidGlassSurface
                x:Name="SearchHost"
                Height="38"
                MinHeight="38"
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Shadow="{x:Null}"
                SurfaceKind="Command"
                Background="{ThemeResource FilesMate.AddressBar.BackgroundBrush}"
                BorderBrush="{ThemeResource FilesMate.AddressBar.BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource FilesMate.Corner.Omnibar}"
                PointerEntered="SearchHost_PointerEntered"
                PointerExited="SearchHost_PointerExited"
                Style="{StaticResource FilesMate.LiquidGlassSurfaceStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SearchScopeButton" Click="SearchScopeButton_Click"
                        Style="{StaticResource SearchActionButtonStyle}" Width="46"
                        Padding="8,0" VerticalAlignment="Center">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon x:Name="SearchScopeIcon" FontSize="16" Glyph="&#xE8B7;"
                                FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" />
                            <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="9"
                                FontFamily="Segoe Fluent Icons" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Grid
                        x:Name="SearchInputArea" Grid.Column="1"
                        MinWidth="0"
                        Background="Transparent">
                        <TextBlock
                            x:Name="SearchPlaceholderLabel"
                            Margin="12,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"
                            IsHitTestVisible="False"
                            Text="Search files"
                            TextTrimming="CharacterEllipsis" />
                        <TextBox
                            x:Name="SearchBox"
                            Padding="12,0,4,0"
                            MinHeight="0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Left"
                            FontSize="14"
                            MinWidth="0"
                            Background="{ThemeResource FilesMate.TextControl.CaretHostBrush}"
                            BorderThickness="0"
                            IsTabStop="True"
                            IsHitTestVisible="True"
                            IsSpellCheckEnabled="False"
                            IsTextPredictionEnabled="False"
                            Foreground="{ThemeResource FilesMate.Text.PrimaryBrush}"
                            GotFocus="SearchBox_GotFocus"
                            LostFocus="SearchBox_LostFocus"
                            TextChanged="SearchBox_TextChanged"
                            KeyDown="SearchBox_KeyDown">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="FilesMate.TextControl.CaretHostBrush" />
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlButtonForeground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessPointerOver">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                    <Button
                        x:Name="ClearSearchButton"
                        Grid.Column="2"
                        Width="28"
                        MinWidth="28"
                        Padding="0"
                        Visibility="Collapsed"
                        Click="ClearSearchButton_Click"
                        Style="{StaticResource SearchActionButtonStyle}">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="10" Glyph="&#xE711;" />
                    </Button>
                    <Button
                        x:Name="SearchButton"
                        Grid.Column="3"
                        Click="SearchButton_Click"
                        Style="{StaticResource SearchActionButtonStyle}"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Search"
                        ToolTipService.ToolTip="Search">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE721;" />
                    </Button>
                </Grid>
            </glass:LiquidGlassSurface>
            </Grid>
        </Grid>
        <Popup
            x:Name="CrumbFolderPopup"
            IsLightDismissEnabled="False"
            ShouldConstrainToRootBounds="True">
            <Border
                x:Name="CrumbFolderHost"
                IsHitTestVisible="False"
                KeyDown="CrumbFolder_KeyDown"
                MinWidth="220"
                MaxHeight="360"
                Padding="0,4"
                Opacity="0"
                Background="{ThemeResource FilesMate.Menu.BackgroundBrush}"
                BorderBrush="{ThemeResource FilesMate.LiquidGlass.BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource FilesMate.Corner.Card}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="CrumbFolderSlide" Y="-8" />
                </Border.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CrumbFolderItems" />
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
