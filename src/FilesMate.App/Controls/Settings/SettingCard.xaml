<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FilesMate.App.Controls.Settings.SettingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="72">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="LayoutGrid" Padding="18,14" ColumnSpacing="20" SizeChanged="LayoutGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="TextHost" Spacing="3" VerticalAlignment="Center">
                <TextBlock
                    x:Name="TitleText"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource FilesMate.Text.PrimaryBrush}"
                    Text="{x:Bind Title, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="DescriptionText"
                    FontSize="12.5"
                    Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"
                    Text="{x:Bind Description, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <ContentPresenter
                x:Name="ActionHost"
                Grid.Column="1"
                VerticalAlignment="Center"
                Content="{x:Bind Action, Mode=OneWay}" />
        </Grid>
        <Border
            x:Name="Divider"
            Grid.Row="1"
            Height="1"
            Margin="18,0"
            Background="{ThemeResource FilesMate.Divider.Brush}"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
