<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <Compile Remove="Models\SearchHitKind.cs;Models\HomeSearchHit.cs;Services\SearchHitRanking.cs;Icons\FileTypeIconCatalog.cs" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>FilesMate.App</RootNamespace>
    <AssemblyTitle>FilesMate</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Branding\FilesMate.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-x64.pubxml')">win-x64.pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(FilesMateUITest)' == 'true'">
    <DefineConstants>$(DefineConstants);FILESMATE_UI_TEST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\PdfPreview\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Branding\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Branding\**\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Branding\FilesMate.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\FileIcons\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\FileIcons\**\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.6.1" />
    <!-- Component packages keep unused AI/ML/Search/Widgets out of offline builds. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <ProjectReference Include="..\FilesMate.Core\FilesMate.Core.csproj" />
    <ProjectReference Include="..\FilesMate.Search\FilesMate.Search.csproj" />
    <ProjectReference Include="..\FilesMate.Platform.Windows\FilesMate.Platform.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <Target Name="BuildSearchHost" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and '$(FilesMateUITest)' != 'true'">
    <MSBuild Projects="..\FilesMate.SearchHost\FilesMate.SearchHost.csproj" Targets="Restore;Publish" BuildInParallel="false"
             Properties="Configuration=$(Configuration);Platform=x64;RuntimeIdentifier=win-x64;SelfContained=true;OutputPath=$(MSBuildProjectDirectory)\..\..\artifacts\search-host-build\$(Configuration)\;PublishDir=$(TargetDir)SearchHost\;DebugType=None;DebugSymbols=false" />
  </Target>
  <Target Name="PublishSearchHost" AfterTargets="Publish" Condition="'$(FilesMateUITest)' != 'true'">
    <ItemGroup><SearchHostFiles Include="$(TargetDir)SearchHost\**\*" /></ItemGroup>
    <Copy SourceFiles="@(SearchHostFiles)" DestinationFiles="@(SearchHostFiles->'$(PublishDir)SearchHost\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
