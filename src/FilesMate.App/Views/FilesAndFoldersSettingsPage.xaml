<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FilesMate.App.Views.FilesAndFoldersSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FilesMate.App.Localization"
    xmlns:glass="using:FilesMate.App.Controls.Glass"
    xmlns:settings="using:FilesMate.App.Controls.Settings">
    <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Spacing="0">
        <TextBlock
            x:Name="Heading"
            Style="{StaticResource FilesMate.SettingsHeadingStyle}"
            Text="Files &amp; folders" />
        <TextBlock x:Name="Lead" Style="{StaticResource FilesMate.SettingsLeadStyle}" />
        <TextBlock Text="{loc:LocalizedText Key=Archive_Settings}" Style="{StaticResource FilesMate.SectionHeaderStyle}" />
        <glass:LiquidGlassSurface Padding="0" Style="{StaticResource FilesMate.GlassCardStyle}">
            <StackPanel>
                <settings:SettingCard Title="{loc:LocalizedText Key=Archive_Preferred}" Description="{loc:LocalizedText Key=Archive_PreferredHint}" ShowDivider="True">
                    <ComboBox x:Name="ArchiveProviderBox" Width="220" SelectionChanged="ArchiveProvider_Changed"
                              AutomationProperties.AutomationId="ArchiveProviderBox" AutomationProperties.Name="{loc:LocalizedText Key=Archive_Preferred}" />
                </settings:SettingCard>
                <StackPanel Padding="16,8,16,16" Spacing="10">
                    <TextBlock x:Name="ArchiveProviderHint" TextWrapping="Wrap" />
                    <TextBlock x:Name="ArchiveProviderPath" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" Visibility="Collapsed" />
                    <StackPanel x:Name="ArchiveProviderActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                        <Button x:Name="ArchiveBrowse" Content="{loc:LocalizedText Key=Archive_BrowseApp}" Click="ArchiveBrowse_Click" />
                        <Button x:Name="ArchiveReset" Content="{loc:LocalizedText Key=Archive_AutoDetect}" Click="ArchiveReset_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </glass:LiquidGlassSurface>
        <TextBlock x:Name="FoldersHeader" Style="{StaticResource FilesMate.SectionHeaderStyle}" Text="File list" />
        <glass:LiquidGlassSurface Padding="0" Style="{StaticResource FilesMate.GlassCardStyle}">
            <StackPanel>
                <settings:SettingCard x:Name="FileOpeningCard" Title="{loc:LocalizedText Key=Opening_FileTitle}" Description="{loc:LocalizedText Key=Opening_Hint}" ShowDivider="True">
                    <ComboBox x:Name="FileOpeningModeBox" MinWidth="160" MinHeight="34"
                              CornerRadius="{StaticResource FilesMate.Corner.Small}"
                              SelectionChanged="OpeningMode_Changed"
                              AutomationProperties.AutomationId="FileOpeningModeBox"
                              AutomationProperties.Name="{loc:LocalizedText Key=Opening_FileTitle}">
                        <ComboBoxItem Content="{loc:LocalizedText Key=Opening_DoubleClick}" />
                        <ComboBoxItem Content="{loc:LocalizedText Key=Opening_SingleClick}" />
                        <ComboBoxItem Content="{loc:LocalizedText Key=Opening_NameClick}" />
                    </ComboBox>
                </settings:SettingCard>
                <settings:SettingCard x:Name="FolderOpeningCard" Title="{loc:LocalizedText Key=Opening_FolderTitle}" Description="{loc:LocalizedText Key=Opening_FolderHint}" ShowDivider="True">
                    <ComboBox x:Name="FolderOpeningModeBox" MinWidth="160" MinHeight="34"
                              CornerRadius="{StaticResource FilesMate.Corner.Small}"
                              SelectionChanged="OpeningMode_Changed"
                              AutomationProperties.AutomationId="FolderOpeningModeBox"
                              AutomationProperties.Name="{loc:LocalizedText Key=Opening_FolderTitle}">
                        <ComboBoxItem Content="{loc:LocalizedText Key=Opening_DoubleClick}" />
                        <ComboBoxItem Content="{loc:LocalizedText Key=Opening_SingleClick}" />
                        <ComboBoxItem Content="{loc:LocalizedText Key=Opening_NameClick}" />
                    </ComboBox>
                </settings:SettingCard>
                <settings:SettingCard Title="{loc:LocalizedText Key=Favorites_Bar}" Description="{loc:LocalizedText Key=Favorites_SettingsHint}" ShowDivider="True">
                    <ToggleSwitch x:Name="FavoritesToggle" MinWidth="0" Toggled="FavoritesToggle_Toggled" />
                </settings:SettingCard>
                <settings:SettingCard Title="{loc:LocalizedText Key=Setup_Guide}" Description="{loc:LocalizedText Key=Setup_GuideHint}" ShowDivider="True">
                    <Button x:Name="FeatureSetupButton" Content="{loc:LocalizedText Key=Setup_Reopen}" Click="FeatureSetup_Click" />
                </settings:SettingCard>
                <settings:SettingCard Title="{loc:LocalizedText Key=View_Scope}" Description="{loc:LocalizedText Key=View_ScopeHint}" ShowDivider="True">
                    <ComboBox x:Name="ViewScopeBox" MinWidth="190" MinHeight="34" CornerRadius="{StaticResource FilesMate.Corner.Small}" SelectionChanged="ViewScope_Changed">
                        <ComboBoxItem Content="{loc:LocalizedText Key=View_PerFolder}"/>
                        <ComboBoxItem Content="{loc:LocalizedText Key=View_Shared}"/>
                    </ComboBox>
                </settings:SettingCard>
                <settings:SettingCard
                    x:Name="StartupViewCard"
                    Title="Default view"
                    Description="New tabs use this layout. You can still switch details and icons from the toolbar."
                    ShowDivider="True">
                    <ComboBox
                        x:Name="DefaultViewBox"
                        MinWidth="160"
                        MinHeight="34"
                        CornerRadius="{StaticResource FilesMate.Corner.Small}"
                        SelectionChanged="DefaultViewBox_SelectionChanged">
                        <ComboBoxItem x:Name="ViewIconsItem" Content="Icons" Tag="Icons" />
                        <ComboBoxItem x:Name="ViewDetailsItem" Content="Details" Tag="Details" />
                        <ComboBoxItem x:Name="ViewListItem" Content="List" Tag="List" />
                    </ComboBox>
                </settings:SettingCard>
                <settings:SettingCard
                    x:Name="ExtensionsCard"
                    Title="Show file extensions"
                    Description="Keep the type suffix visible in names, the way Explorer does when this option is on."
                    ShowDivider="True">
                    <ToggleSwitch x:Name="ExtensionsToggle" MinWidth="0" Toggled="ExtensionsToggle_Toggled" />
                </settings:SettingCard>
                <settings:SettingCard
                    x:Name="HiddenFilesCard"
                    Title="Show hidden files"
                    Description="Include hidden and system items while browsing folders."
                    ShowDivider="True">
                    <ToggleSwitch x:Name="HiddenFilesToggle" MinWidth="0" Toggled="HiddenFilesToggle_Toggled" />
                </settings:SettingCard>
                <settings:SettingCard
                    x:Name="FolderSizesCard"
                    Title="Show folder sizes"
                    Description="Walk folder contents to fill the Size column. Off by default because it can be slow on large trees."
                    ShowDivider="True">
                    <ToggleSwitch x:Name="FolderSizesToggle" MinWidth="0" Toggled="FolderSizesToggle_Toggled" />
                </settings:SettingCard>
                <settings:SettingCard Title="{loc:LocalizedText Key=Grouping_Default}" Description="{loc:LocalizedText Key=Grouping_DefaultHint}">
            <ComboBox x:Name="DefaultGroupingBox" Width="180" SelectionChanged="DefaultGrouping_Changed">
                <ComboBoxItem Tag="FoldersFirst" Content="{loc:LocalizedText Key=Sort_FoldersFirst}"/>
                <ComboBoxItem Tag="Mixed" Content="{loc:LocalizedText Key=Sort_Mixed}"/>
                <ComboBoxItem Tag="FilesFirst" Content="{loc:LocalizedText Key=Sort_FilesFirst}"/>
            </ComboBox>
        </settings:SettingCard>
        <settings:SettingCard x:Name="DefaultSortDirectionCard" Title="{loc:LocalizedText Key=Sort_DefaultDirection}" Description="{loc:LocalizedText Key=Sort_DefaultDirectionHint}" ShowDivider="True">
                    <ComboBox x:Name="DefaultSortDirectionBox" MinWidth="160" MinHeight="34" CornerRadius="{StaticResource FilesMate.Corner.Small}" SelectionChanged="DefaultSortDirection_Changed" AutomationProperties.Name="{loc:LocalizedText Key=Sort_DefaultDirection}">
                        <ComboBoxItem Content="{loc:LocalizedText Key=Sort_Ascending}" />
                        <ComboBoxItem Content="{loc:LocalizedText Key=Sort_Descending}" />
                    </ComboBox>
                </settings:SettingCard>
                <settings:SettingCard Title="{loc:LocalizedText Key=Sort_MixedPinyin}" Description="{loc:LocalizedText Key=Sort_MixedPinyinHint}" ShowDivider="True">
                    <ToggleSwitch x:Name="MixedNameSortToggle" MinWidth="0" Toggled="MixedNameSortToggle_Toggled" AutomationProperties.Name="{loc:LocalizedText Key=Sort_MixedPinyin}" />
                </settings:SettingCard>
                <settings:SettingCard x:Name="AlternatingRowsCard" Title="{loc:LocalizedText Key=View_AlternatingRows}" Description="{loc:LocalizedText Key=View_AlternatingRowsHint}" ShowDivider="True">
                    <ToggleSwitch x:Name="AlternatingRowsToggle" MinWidth="0" Toggled="AlternatingRowsToggle_Toggled" AutomationProperties.Name="{loc:LocalizedText Key=View_AlternatingRows}" />
                </settings:SettingCard>
                <settings:SettingCard x:Name="AutoNameWidthCard" Title="{loc:LocalizedText Key=Columns_AutoNameWidth}" Description="{loc:LocalizedText Key=Columns_AutoNameWidthHint}" ShowDivider="True">
                    <ToggleSwitch x:Name="AutoNameWidthToggle" MinWidth="0" Toggled="AutoNameWidth_Toggled" AutomationProperties.Name="{loc:LocalizedText Key=Columns_AutoNameWidth}" />
                </settings:SettingCard>
                <settings:SettingCard
                    x:Name="DateFormatCard"
                    Title="Date format"
                    Description="Use your Windows regional format, or a fixed year-month-day stamp.">
                    <ComboBox
                        x:Name="DateFormatBox"
                        MinWidth="160"
                        MinHeight="34"
                        CornerRadius="{StaticResource FilesMate.Corner.Small}"
                        SelectionChanged="DateFormatBox_SelectionChanged">
                        <ComboBoxItem x:Name="DateSystemItem" Content="Windows" Tag="System" />
                        <ComboBoxItem x:Name="DateIsoItem" Content="ISO" Tag="Iso" />
                    </ComboBox>
                </settings:SettingCard>
            </StackPanel>
        </glass:LiquidGlassSurface>
        <TextBlock Text="{loc:LocalizedText Key=Thumbnail_Section}" Style="{StaticResource FilesMate.SettingsSectionHeaderStyle}" />
        <glass:LiquidGlassSurface x:Name="ThumbnailSettingsSection" Padding="0" Style="{StaticResource FilesMate.GlassCardStyle}">
            <StackPanel>
                <settings:SettingCard x:Name="ThumbnailQualityCard" Title="{loc:LocalizedText Key=Thumbnail_Quality}" Description="{loc:LocalizedText Key=Thumbnail_QualityHint}">
                    <ComboBox x:Name="ThumbnailQualityBox" MinWidth="160" SelectionChanged="ThumbnailQuality_Changed"
                              AutomationProperties.AutomationId="ThumbnailQualityBox" AutomationProperties.Name="{loc:LocalizedText Key=Thumbnail_Quality}">
                        <ComboBoxItem Tag="Standard" Content="{loc:LocalizedText Key=Thumbnail_Standard}" />
                        <ComboBoxItem Tag="High" Content="{loc:LocalizedText Key=Thumbnail_High}" />
                        <ComboBoxItem Tag="Ultra" Content="{loc:LocalizedText Key=Thumbnail_Ultra}" />
                    </ComboBox>
                </settings:SettingCard>
                <TextBlock x:Name="ThumbnailResourceHint" Margin="16,8,16,12" Text="{loc:LocalizedText Key=Thumbnail_ResourceHint}"
                           TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" Visibility="Collapsed" />
                <Border x:Name="ThumbnailQualityDivider" Height="1" Margin="18,0" Background="{ThemeResource FilesMate.Divider.Brush}" />
                <settings:SettingCard x:Name="FullThumbnailsCard" Title="{loc:LocalizedText Key=Thumbnail_Full}" Description="{loc:LocalizedText Key=Thumbnail_FullHint}" ShowDivider="True">
                    <ToggleSwitch x:Name="FullThumbnailsToggle" MinWidth="0" Toggled="FullThumbnails_Toggled"
                                  AutomationProperties.AutomationId="FullThumbnailsToggle" AutomationProperties.Name="{loc:LocalizedText Key=Thumbnail_Full}" />
                </settings:SettingCard>
                <settings:SettingCard x:Name="GridFileSizesCard" Title="{loc:LocalizedText Key=Thumbnail_FileSizes}" Description="{loc:LocalizedText Key=Thumbnail_FileSizesHint}">
                    <ToggleSwitch x:Name="GridFileSizesToggle" MinWidth="0" Toggled="GridFileSizes_Toggled"
                                  AutomationProperties.AutomationId="GridFileSizesToggle" AutomationProperties.Name="{loc:LocalizedText Key=Thumbnail_FileSizes}" />
                </settings:SettingCard>
            </StackPanel>
        </glass:LiquidGlassSurface>
        <TextBlock
            x:Name="AlphabetHeader"
            Style="{StaticResource FilesMate.SettingsSectionHeaderStyle}"
            Text="Alphabet navigation" />
        <glass:LiquidGlassSurface Padding="0" Style="{StaticResource FilesMate.GlassCardStyle}">
            <StackPanel>
                <settings:SettingCard
                    x:Name="AlphabetCard"
                    Title="Enable alphabet navigation"
                    Description="Show the alphabet rail, letter bubble, and range indicator while sorting by name."
                    ShowDivider="True">
                    <ToggleSwitch
                        x:Name="AlphabetToggle"
                        MinWidth="0"
                        Toggled="AlphabetToggle_Toggled"
                        AutomationProperties.Name="Enable alphabet navigation" />
                </settings:SettingCard>
                <settings:SettingCard
                    x:Name="AlphabetMinimumItemsCard"
                    Title="Minimum item count"
                    Description="Use the normal scroll bar when the folder is already small enough to scan at a glance."
                    ShowDivider="True">
                    <NumberBox
                        x:Name="AlphabetMinimumItemsBox"
                        Width="116"
                        Minimum="0"
                        Maximum="10000"
                        SmallChange="1"
                        LargeChange="10"
                        SpinButtonPlacementMode="Hidden"
                        ValueChanged="AlphabetMinimumItemsBox_ValueChanged"
                        AutomationProperties.Name="Minimum item count" />
                </settings:SettingCard>
                <settings:SettingCard
                    x:Name="AlphabetDualPaneCard"
                    Title="Show in dual-pane mode"
                    Description="Allow the alphabet rail in both panes even though each pane has less reading space.">
                    <ToggleSwitch
                        x:Name="AlphabetDualPaneToggle"
                        MinWidth="0"
                        Toggled="AlphabetDualPaneToggle_Toggled"
                        AutomationProperties.Name="Show alphabet navigation in dual-pane mode" />
                </settings:SettingCard>
            </StackPanel>
        </glass:LiquidGlassSurface>
        <TextBlock
            x:Name="SafetyHeader"
            Style="{StaticResource FilesMate.SettingsSectionHeaderStyle}"
            Text="Safety" />
        <glass:LiquidGlassSurface Padding="0" Style="{StaticResource FilesMate.GlassCardStyle}">
            <settings:SettingCard
                x:Name="ConfirmDeleteCard"
                Title="Confirm permanent delete"
                Description="Ask before permanently deleting selected items.">
                <ToggleSwitch x:Name="ConfirmDeleteToggle" MinWidth="0" Toggled="ConfirmDeleteToggle_Toggled" />
            </settings:SettingCard>
        </glass:LiquidGlassSurface>
        <TextBlock Style="{StaticResource FilesMate.SettingsSectionHeaderStyle}" Text="{loc:LocalizedText Key=Backup_Title}" />
        <glass:LiquidGlassSurface Padding="0" Style="{StaticResource FilesMate.GlassCardStyle}">
            <settings:SettingCard Title="{loc:LocalizedText Key=Backup_Title}" Description="{loc:LocalizedText Key=Backup_SettingsHint}">
                <Button x:Name="BackupManageButton" Content="{loc:LocalizedText Key=Backup_Manage}" Click="BackupManage_Click" />
            </settings:SettingCard>
        </glass:LiquidGlassSurface>
        <TextBlock
            x:Name="SidebarHeader"
            Style="{StaticResource FilesMate.SettingsSectionHeaderStyle}"
            Text="Sidebar" />
        <glass:LiquidGlassSurface Padding="0" Style="{StaticResource FilesMate.GlassCardStyle}">
            <settings:SettingCard
                x:Name="SidebarPinsCard"
                Title="Sidebar pinned items"
                Description="Remove any pinned location from its context menu, or restore the familiar defaults here.">
                <Button
                    x:Name="RestoreSidebarButton"
                    Padding="14,6"
                    Click="RestoreSidebarButton_Click"
                    Style="{StaticResource GlassButtonStyle}" />
            </settings:SettingCard>
        </glass:LiquidGlassSurface>
        <TextBlock
            x:Name="StatusText"
            Margin="4,10,4,0"
            Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"
            FontSize="12"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <TextBlock
            x:Name="ErrorText"
            Margin="4,10,4,0"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            FontSize="12"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
