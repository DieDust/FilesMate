<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FilesMate.App.Views.TagManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:glass="using:FilesMate.App.Controls.Glass">
    <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">
        <TextBlock
            x:Name="Heading"
            Style="{StaticResource FilesMate.SettingsHeadingStyle}"
            Text="Tags" />
        <TextBlock x:Name="Lead" Style="{StaticResource FilesMate.SettingsLeadStyle}" />
        <Grid Margin="4,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TagsHeader"
                VerticalAlignment="Center"
                Style="{StaticResource FilesMate.SectionHeaderStyle}"
                Text="Tags" />
            <Button
                x:Name="NewTagButton"
                Grid.Column="1"
                Padding="12,5"
                Click="NewTagButton_Click"
                Style="{StaticResource GlassButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="13" Glyph="&#xE710;" />
                    <TextBlock x:Name="NewTagLabel" Text="New tag" />
                </StackPanel>
            </Button>
        </Grid>
        <glass:LiquidGlassSurface Padding="0" Style="{StaticResource FilesMate.GlassCardStyle}">
            <Grid MinHeight="96">
                <StackPanel x:Name="TagRows" />
                <TextBlock
                    x:Name="EmptyText"
                    Margin="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"
                    Text="No tags yet"
                    Visibility="Collapsed" />
            </Grid>
        </glass:LiquidGlassSurface>
        <TextBlock
            x:Name="ErrorText"
            Margin="4,10,4,0"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            FontSize="12"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
