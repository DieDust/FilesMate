<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FilesMate.App.Views.PageLoadErrorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40">
        <StackPanel
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <FontIcon
                HorizontalAlignment="Left"
                FontFamily="Segoe Fluent Icons"
                FontSize="28"
                Glyph="&#xEA39;" />
            <TextBlock
                x:Name="TitleText"
                FontSize="24"
                FontWeight="SemiBold"
                Text="This page couldn't open"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="BodyText"
                FontSize="14"
                Opacity="0.72"
                Text="FilesMate kept the window open. Copy the diagnostics if you want to report this problem."
                TextWrapping="Wrap" />
            <Button
                x:Name="CopyButton"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                Click="CopyButton_Click"
                Content="Copy diagnostics" />
        </StackPanel>
    </Grid>
</Page>
