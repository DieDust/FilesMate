<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FilesMate.App.Views.SearchSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FilesMate.App.Localization"
    xmlns:glass="using:FilesMate.App.Controls.Glass"
    xmlns:settings="using:FilesMate.App.Controls.Settings">
    <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Spacing="0">
        <TextBlock
            x:Name="Heading"
            Style="{StaticResource FilesMate.SettingsHeadingStyle}"
            Text="Search" />
        <TextBlock Text="{loc:LocalizedText Key=GlobalSearch}" Style="{StaticResource FilesMate.SectionHeaderStyle}" Margin="4,16,0,4" />
        <TextBlock Text="{loc:LocalizedText Key=Search_LeadShortcut}"
                   Margin="4,0,4,10" FontSize="12.5" TextWrapping="Wrap" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
        <glass:LiquidGlassSurface Padding="14" Margin="0,0,0,18" Style="{StaticResource FilesMate.GlassCardStyle}">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="GlobalSearchStateIcon" FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xEA3A;" VerticalAlignment="Center" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                    <TextBlock x:Name="GlobalSearchStatus" Text="{loc:LocalizedText Key=Search_Detecting}" TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>
                <ToggleSwitch x:Name="GlobalSearchResident" Toggled="GlobalSearchToggle_Changed" Header="{loc:LocalizedText Key=Search_Residency}" IsOn="True" />
                <TextBlock Text="{loc:LocalizedText Key=Search_ResidencyHint}"
                           TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                <ToggleSwitch x:Name="GlobalSearchStartup" Toggled="GlobalSearchToggle_Changed" Header="{loc:LocalizedText Key=Search_StartAtLogin}" IsOn="True" />
                <TextBlock x:Name="GlobalSearchStartupHint" Text="{loc:LocalizedText Key=Search_StartupHint}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                <ToggleSwitch x:Name="GlobalSearchPreview" Toggled="GlobalSearchToggle_Changed" Header="{loc:LocalizedText Key=Search_PreviewFiles}" IsOn="True" />
                <TextBlock Text="{loc:LocalizedText Key=Search_PreviewHint}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="GlobalSearchHotkey" TextChanged="GlobalSearchHotkey_Changed" Header="{loc:LocalizedText Key=SearchShortcut}" Text="Alt+Space" PlaceholderText="{loc:LocalizedText Key=Shortcut_ExampleF}" Width="220" />
                    <Button x:Name="GlobalSearchCapture" Content="{loc:LocalizedText Key=Shortcut_Record}" VerticalAlignment="Bottom" Click="GlobalSearchCapture_Click" KeyDown="GlobalSearchCapture_KeyDown" LostFocus="GlobalSearchCapture_LostFocus" />
                </StackPanel>
                <ComboBox x:Name="GlobalSearchTrayAction" SelectionChanged="GlobalSearchTray_Changed" Header="{loc:LocalizedText Key=Search_TrayAction}" SelectedIndex="0" MinWidth="200">
                    <ComboBoxItem Content="{loc:LocalizedText Key=Search_Palette}"/><ComboBoxItem Content="{loc:LocalizedText Key=FileManager}"/>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="GlobalSearchOpen" Content="{loc:LocalizedText Key=Search_Open}" Click="GlobalSearchOpen_Click" />
                </StackPanel>
                <TextBlock x:Name="GlobalSearchSaveStatus" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
            </StackPanel>
        </glass:LiquidGlassSurface>
        <TextBlock x:Name="IndexHeader" Style="{StaticResource FilesMate.SectionHeaderStyle}" Text="Index" Margin="4,0,0,4" />
        <TextBlock x:Name="Lead" Style="{StaticResource FilesMate.SettingsLeadStyle}" Margin="4,0,4,12" FontSize="12.5" />
        <Grid x:Name="StatsGrid" Margin="0,0,0,16" ColumnSpacing="10" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <glass:LiquidGlassSurface x:Name="StatFilesCard" Grid.Row="0" Grid.Column="0" Padding="14" Style="{StaticResource FilesMate.GlassCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="StatFilesLabel" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                    <TextBlock x:Name="StatFilesValue" FontSize="22" FontWeight="SemiBold" Text="0" />
                </StackPanel>
            </glass:LiquidGlassSurface>
            <glass:LiquidGlassSurface x:Name="StatFoldersCard" Grid.Row="0" Grid.Column="1" Padding="14" Style="{StaticResource FilesMate.GlassCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="StatFoldersLabel" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                    <TextBlock x:Name="StatFoldersValue" FontSize="22" FontWeight="SemiBold" Text="0" />
                </StackPanel>
            </glass:LiquidGlassSurface>
            <glass:LiquidGlassSurface x:Name="StatErrorsCard" Grid.Row="1" Grid.Column="0" Padding="14" Style="{StaticResource FilesMate.GlassCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="StatErrorsLabel" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                    <TextBlock x:Name="StatErrorsValue" FontSize="22" FontWeight="SemiBold" Text="0" />
                </StackPanel>
            </glass:LiquidGlassSurface>
            <glass:LiquidGlassSurface x:Name="StatIndexedCard" Grid.Row="1" Grid.Column="1" Padding="14" Style="{StaticResource FilesMate.GlassCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="StatIndexedLabel" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                    <TextBlock x:Name="StatIndexedValue" FontSize="22" FontWeight="SemiBold" Text="0" />
                </StackPanel>
            </glass:LiquidGlassSurface>
            <glass:LiquidGlassSurface Grid.Row="2" Padding="14" Style="{StaticResource FilesMate.GlassCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:LocalizedText Key=SearchDiskUsage}" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                    <TextBlock x:Name="StatSizeValue" FontSize="22" FontWeight="SemiBold" Text="…" />
                    <TextBlock Text="{loc:LocalizedText Key=SearchDiskUsageHint}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                </StackPanel>
            </glass:LiquidGlassSurface>
            <glass:LiquidGlassSurface Grid.Row="2" Grid.Column="1" Padding="14" Style="{StaticResource FilesMate.GlassCardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:LocalizedText Key=SearchLastCompleted}" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                    <TextBlock x:Name="StatCompletedValue" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
            </glass:LiquidGlassSurface>
        </Grid>
        <glass:LiquidGlassSurface Padding="0" Style="{StaticResource FilesMate.GlassCardStyle}">
            <StackPanel>
                <settings:SettingCard x:Name="IndexCard" Title="Name index" ShowDivider="True">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="IndexButton" Padding="14,6" Click="IndexButton_Click" Style="{StaticResource GlassButtonStyle}" />
                        <Button x:Name="CancelButton" Padding="14,6" Click="CancelButton_Click" IsEnabled="False" Style="{StaticResource GlassButtonStyle}" />
                    </StackPanel>
                </settings:SettingCard>
                <settings:SettingCard x:Name="ProgressCard" Title="Progress" ShowDivider="True">
                    <ProgressBar x:Name="IndexProgress" Width="180" IsIndeterminate="False" />
                </settings:SettingCard>
                <settings:SettingCard x:Name="DepthCard" Title="Folder depth" ShowDivider="True">
                    <ComboBox
                        x:Name="DepthBox"
                        MinWidth="160"
                        MinHeight="34"
                        CornerRadius="{StaticResource FilesMate.Corner.Small}"
                        SelectionChanged="DepthBox_SelectionChanged">
                        <ComboBoxItem x:Name="DepthUnlimitedItem" Content="Unlimited" Tag="0" />
                        <ComboBoxItem Content="1" Tag="1" />
                        <ComboBoxItem Content="2" Tag="2" />
                        <ComboBoxItem Content="3" Tag="3" />
                        <ComboBoxItem Content="4" Tag="4" />
                        <ComboBoxItem Content="5" Tag="5" />
                        <ComboBoxItem Content="6" Tag="6" />
                        <ComboBoxItem Content="8" Tag="8" />
                        <ComboBoxItem Content="16" Tag="16" />
                    </ComboBox>
                </settings:SettingCard>
                <settings:SettingCard x:Name="IndexLocationCard" Title="Index location" ShowDivider="True">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="OpenLocationButton" Padding="14,6" Click="OpenLocationButton_Click" Style="{StaticResource GlassButtonStyle}" />
                        <Button x:Name="ChangeLocationButton" Padding="14,6" Click="ChangeLocationButton_Click" Style="{StaticResource GlassButtonStyle}" />
                    </StackPanel>
                </settings:SettingCard>
                <settings:SettingCard x:Name="ParallelCard" Title="Scan drives together" ShowDivider="True">
                    <ToggleSwitch x:Name="ParallelToggle" Toggled="ParallelToggle_Toggled" />
                </settings:SettingCard>
                <settings:SettingCard x:Name="AutoRefreshCard" Title="Keep index fresh">
                    <ToggleSwitch x:Name="AutoRefreshToggle" Toggled="AutoRefreshToggle_Toggled" />
                </settings:SettingCard>
            </StackPanel>
        </glass:LiquidGlassSurface>
        <TextBlock x:Name="ProgressText" Margin="4,8,4,0" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="RankHeader" Style="{StaticResource FilesMate.SettingsSectionHeaderStyle}" Text="Result order" />
        <TextBlock
            x:Name="RankLead"
            Margin="4,0,4,8"
            FontSize="12.5"
            Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"
            TextWrapping="Wrap" />
        <glass:LiquidGlassSurface Padding="8,4" Style="{StaticResource FilesMate.GlassCardStyle}">
            <ListView
                x:Name="RankList"
                AllowDrop="True"
                Background="Transparent"
                BorderThickness="0"
                CanDragItems="True"
                CanReorderItems="True"
                DragItemsCompleted="RankList_DragItemsCompleted"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="40" />
                        <Setter Property="Padding" Value="8,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"
                                Glyph="&#xE76F;"
                                IsHitTestVisible="False" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Text="{Binding Title}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </glass:LiquidGlassSurface>
        <TextBlock x:Name="DrivesHeader" Style="{StaticResource FilesMate.SettingsSectionHeaderStyle}" Text="Drives" />
        <glass:LiquidGlassSurface Padding="16" Style="{StaticResource FilesMate.GlassCardStyle}">
            <StackPanel x:Name="DriveHost" Spacing="8" />
        </glass:LiquidGlassSurface>
        <TextBlock x:Name="ExclusionsHeader" Style="{StaticResource FilesMate.SettingsSectionHeaderStyle}" Text="Exclusions" />
        <glass:LiquidGlassSurface Padding="16" Style="{StaticResource FilesMate.GlassCardStyle}">
            <StackPanel Spacing="8">
                <TextBlock x:Name="ExclusionsLead" FontSize="12.5" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" TextWrapping="Wrap" />
                <TextBox
                    x:Name="ExclusionsBox"
                    AcceptsReturn="True"
                    MinHeight="88"
                    TextWrapping="Wrap"
                    LostFocus="ExclusionsBox_LostFocus" />
            </StackPanel>
        </glass:LiquidGlassSurface>
    </StackPanel>
</UserControl>
