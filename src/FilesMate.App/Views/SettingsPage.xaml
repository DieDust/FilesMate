<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FilesMate.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FilesMate.App.Localization"
    Background="Transparent">
    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource FilesMate.Text.PrimaryBrush}" />
        </Style>
        <Style TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource FilesMate.Text.PrimaryBrush}" />
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Padding="24,16,16,16"
            Background="{ThemeResource FilesMate.SettingsNav.BackgroundBrush}"
            BorderBrush="{ThemeResource FilesMate.Card.BorderBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="SettingsSubtitle"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="Settings" />
                <TextBlock
                    x:Name="SettingsCaption"
                    Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"
                    FontSize="12"
                    Text="FilesMate" />
            </StackPanel>
            <Button
                x:Name="CloseButton"
                Width="36"
                Height="36"
                Margin="0,0,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="CloseButton_Click"
                Style="{StaticResource ToolbarIconButtonStyle}"
                AutomationProperties.Name="Close settings"
                ToolTipService.ToolTip="Close settings">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Background="{ThemeResource FilesMate.SettingsNav.BackgroundBrush}"
                BorderBrush="{ThemeResource FilesMate.Card.BorderBrush}"
                BorderThickness="0,0,1,0">
                <ListView
                    x:Name="CategoryList"
                    Padding="10,10,10,16"
                    Background="Transparent"
                    IsItemClickEnabled="False"
                    ItemContainerStyle="{StaticResource FilesMate.SettingsNavItemStyle}"
                    SelectionChanged="CategoryList_SelectionChanged"
                    SelectionMode="Single">
                    <ListViewItem Tag="general" IsSelected="True">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Glyph="&#xE770;" />
                            <TextBlock x:Name="GeneralNavLabel" VerticalAlignment="Center" Text="General" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="appearance">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Glyph="&#xE790;" />
                            <TextBlock x:Name="AppearanceNavLabel" VerticalAlignment="Center" Text="Appearance" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="files-folders">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Glyph="&#xE8B7;" />
                            <TextBlock x:Name="FilesAndFoldersNavLabel" VerticalAlignment="Center" Text="Files &amp; folders" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="keyboard">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Glyph="&#xE765;" />
                            <TextBlock x:Name="KeyboardNavLabel" VerticalAlignment="Center" Text="Keyboard" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="search">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Glyph="&#xE721;" />
                            <TextBlock x:Name="SearchNavLabel" VerticalAlignment="Center" Text="Search" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="tags">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Glyph="&#xE8EC;" />
                            <TextBlock x:Name="TagsNavLabel" VerticalAlignment="Center" Text="Tags" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="advanced">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Glyph="&#xE713;" />
                            <TextBlock x:Name="AdvancedNavLabel" VerticalAlignment="Center" Text="Advanced" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="about">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Glyph="&#xE946;" />
                            <TextBlock x:Name="AboutNavLabel" VerticalAlignment="Center" Text="About" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </Border>
            <ScrollViewer
                Grid.Column="1"
                Padding="32,24,32,32"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ContentPresenter
                    x:Name="SectionHost"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
