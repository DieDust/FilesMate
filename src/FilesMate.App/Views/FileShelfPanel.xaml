<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FilesMate.App.Views.FileShelfPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True" DragEnter="Shelf_DragOver" DragOver="Shelf_DragOver"
    DragLeave="Shelf_DragLeave" Drop="Shelf_Drop" KeyDown="Shelf_KeyDown">
    <Grid Padding="14,14,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7B8;" FontSize="16" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="CountText" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="ShelfCloseButton" Grid.Column="2" Click="Close_Click"
                    Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE711;" />
            </Button>
        </Grid>
        <Border x:Name="DropBorder" Grid.Row="1" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10"
                BorderBrush="{ThemeResource FilesMate.Divider.Brush}">
            <Grid MinHeight="104">
                <ListView x:Name="PathsList" MaxHeight="240" SelectionMode="Multiple"
                          CanDragItems="True" CanReorderItems="False" AllowDrop="False"
                          SelectionChanged="SelectionChanged" DragItemsStarting="DragItemsStarting"
                          DragItemsCompleted="DragItemsCompleted">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,5" ColumnSpacing="10" ToolTipService.ToolTip="{Binding Path}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32" Loaded="ItemIcon_Loaded" Unloaded="ItemIcon_Unloaded">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="24" Glyph="&#xE8A5;" />
                                    <Image Stretch="Uniform" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Parent}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="24" Glyph="&#xE7B8;" Opacity="0.35" />
                    <TextBlock x:Name="EmptyText" FontSize="12" Opacity="0.55" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="CopyButton" Click="Copy_Click" Style="{StaticResource CommandBarButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE8C8;" />
                </Button>
                <Button x:Name="MoveButton" Click="Move_Click" Style="{StaticResource CommandBarButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE8DE;" />
                </Button>
                <Button x:Name="CompressButton" Click="Compress_Click" Style="{StaticResource CommandBarButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xF012;" />
                </Button>
                <Button x:Name="SelectButton" Click="Select_Click" Style="{StaticResource CommandBarButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE8B3;" />
                </Button>
                <Button x:Name="CancelButton" Click="Cancel_Click" Visibility="Collapsed" Style="{StaticResource CommandBarButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE71A;" />
                </Button>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="4">
                <Button x:Name="RemoveButton" Click="Remove_Click" Style="{StaticResource CommandBarButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE738;" />
                </Button>
                <Button x:Name="ClearButton" Click="Clear_Click" Style="{StaticResource CommandBarButtonStyle}">
                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xE894;" />
                </Button>
            </StackPanel>
        </Grid>
        <ScrollViewer x:Name="StatusHost" Grid.Row="3" MaxHeight="52" MinHeight="0" Margin="0,8,0,0"
                      Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
        </ScrollViewer>
    </Grid>
</UserControl>
