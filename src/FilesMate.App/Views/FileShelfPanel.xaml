<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FilesMate.App.Views.FileShelfPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True" DragEnter="Shelf_DragOver" DragOver="Shelf_DragOver"
    DragLeave="Shelf_DragLeave" Drop="Shelf_Drop" PreviewKeyDown="Shelf_KeyDown">
    <UserControl.Resources>
        <Style x:Key="ShelfActionStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ShelfPrimaryActionStyle" TargetType="Button" BasedOn="{StaticResource ShelfActionStyle}">
            <Setter Property="Background" Value="{ThemeResource FilesMate.Glass.SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource FilesMate.Glass.BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>
    <Grid Padding="12" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7B8;" FontSize="16" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="CountText" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="MoreButton" Grid.Column="2" Style="{StaticResource ShelfActionStyle}" Padding="8,0">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="CompressButton" Click="Compress_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xF012;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="CopyPathsButton" Click="CopyPaths_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="RevealButton" Click="Reveal_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xED25;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem x:Name="ClearButton" Click="Clear_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE738;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button x:Name="ShelfCloseButton" Grid.Column="3" Click="Close_Click"
                    Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0">
                <FontIcon FontFamily="Segoe Fluent Icons" FontSize="12" Glyph="&#xE711;" />
            </Button>
        </Grid>
        <Grid x:Name="SelectionRow" Grid.Row="1" ColumnSpacing="6" Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="SelectButton" Click="Select_Click" Style="{StaticResource ShelfActionStyle}" Padding="4,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <CheckBox x:Name="SelectIndicator" IsHitTestVisible="False" IsTabStop="False" AutomationProperties.AccessibilityView="Raw"
                              MinHeight="20" MinWidth="0" Padding="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SelectLabel" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="SelectionText" Grid.Column="1" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Button x:Name="AddSelectionButton" Grid.Column="2" Click="AddSelection_Click" Style="{StaticResource ShelfActionStyle}">
                <TextBlock x:Name="AddSelectionLabel" FontSize="12"/>
            </Button>
        </Grid>
        <Border x:Name="DropBorder" Grid.Row="2" BorderThickness="1" CornerRadius="8" Margin="0,6,0,0"
                BorderBrush="{ThemeResource FilesMate.Divider.Brush}">
            <Grid MinHeight="72">
                <ListView x:Name="PathsList" MaxHeight="240" SelectionMode="Multiple"
                          CanDragItems="True" CanReorderItems="False" AllowDrop="False"
                          SelectionChanged="SelectionChanged" DragItemsStarting="DragItemsStarting"
                          DragItemsCompleted="DragItemsCompleted">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,4" ColumnSpacing="8" ToolTipService.ToolTip="{Binding Path}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32" Loaded="ItemIcon_Loaded" Unloaded="ItemIcon_Unloaded">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="24" Glyph="&#xE8A5;" />
                                    <Image Stretch="Uniform" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Parent}" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" Spacing="8">
                    <Border Width="36" Height="36" CornerRadius="10" HorizontalAlignment="Center"
                            Background="{ThemeResource FilesMate.Item.HoverBrush}">
                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="20" Glyph="&#xE7B8;"
                                  Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"/>
                    </Border>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="EmptyText" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"/>
                        <TextBlock x:Name="EmptyHint" FontSize="11" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="250"/>
                    </StackPanel>
                    <Button x:Name="EmptyAddSelectionButton" Click="AddSelection_Click" Style="{StaticResource ShelfPrimaryActionStyle}"
                            HorizontalAlignment="Center" Padding="18,0" Margin="0,4,0,0">
                        <TextBlock x:Name="EmptyAddSelectionLabel" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="ActionsRow" Grid.Row="3" ColumnSpacing="6" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="CopyButton" Click="Copy_Click" Style="{StaticResource ShelfPrimaryActionStyle}"/>
            <Button x:Name="MoveButton" Grid.Column="1" Click="Move_Click" Style="{StaticResource ShelfPrimaryActionStyle}"/>
            <Button x:Name="RemoveButton" Grid.Column="2" Click="Remove_Click" Style="{StaticResource ShelfPrimaryActionStyle}"/>
        </Grid>
        <Grid x:Name="FeedbackRow" Grid.Row="4" ColumnSpacing="6" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ScrollViewer x:Name="StatusHost" MaxHeight="52" MinHeight="0" VerticalAlignment="Center" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
            </ScrollViewer>
            <Button x:Name="UndoRemoveButton" Grid.Column="1" Click="UndoRemove_Click" Visibility="Collapsed" Style="{StaticResource ShelfActionStyle}"/>
            <Button x:Name="CancelButton" Grid.Column="2" Click="Cancel_Click" Visibility="Collapsed" Style="{StaticResource ShelfActionStyle}"/>
        </Grid>
    </Grid>
</UserControl>
