<UserControl x:Class="FilesMate.App.Views.UpdateNoticeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FilesMate.App.Localization">
    <Border x:Name="AnnouncementSurface" Background="{ThemeResource FilesMate.Menu.BackgroundBrush}" BorderBrush="{ThemeResource FilesMate.LiquidGlass.BorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="20">
        <Grid RowSpacing="20" ColumnSpacing="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel x:Name="AnnouncementHeader" Spacing="4">
                <TextBlock x:Name="AnnouncementTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource FilesMate.Text.PrimaryBrush}"/>
                <TextBlock x:Name="AnnouncementVersion" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="AnnouncementCloseButton" Width="32" Height="32" VerticalAlignment="Top"
                    Style="{StaticResource ToolbarIconButtonStyle}" AutomationProperties.Name="{loc:LocalizedText Key=Update_Dismiss}" Click="Dismiss_Click">
                <FontIcon Glyph="&#xE711;" FontSize="12"/>
            </Button>
            <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" x:Name="AnnouncementScroll" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" IsTabStop="False">
                <StackPanel x:Name="AnnouncementBody" Spacing="20"/>
            </ScrollViewer>
            <Button Grid.Row="2" Grid.ColumnSpan="2" x:Name="AnnouncementPrimaryAction" HorizontalAlignment="Right" MinHeight="32"
                    Padding="16,7" Style="{StaticResource AccentButtonStyle}" Click="Install_Click"/>
        </Grid>
    </Border>
</UserControl>
