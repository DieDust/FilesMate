<UserControl x:Class="FilesMate.App.Views.UpdateNoticeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FilesMate.App.Localization">
    <Border Background="{ThemeResource FilesMate.Menu.BackgroundBrush}" BorderBrush="{ThemeResource FilesMate.LiquidGlass.BorderBrush}"
            BorderThickness="1" CornerRadius="14" Padding="20">
        <Grid RowSpacing="12" ColumnSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="{loc:LocalizedText Key=Update_Available}" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource FilesMate.Text.PrimaryBrush}"/>
                <TextBlock x:Name="VersionLabel" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DemoLabel" Text="{loc:LocalizedText Key=Update_Demo}" Visibility="Collapsed" FontSize="12"
                           Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="DismissButton" Width="28" Height="28" VerticalAlignment="Top"
                    Style="{StaticResource ToolbarIconButtonStyle}" AutomationProperties.Name="{loc:LocalizedText Key=Update_Dismiss}" Click="Dismiss_Click">
                <FontIcon Glyph="&#xE711;" FontSize="12"/>
            </Button>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{loc:LocalizedText Key=Update_PreserveHint}"
                       TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}"/>
            <Grid Grid.Row="2" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="{loc:LocalizedText Key=Later}" Padding="12,5" Click="Dismiss_Click"/>
                    <Button x:Name="InstallButton" Content="{loc:LocalizedText Key=Update_Install}" Padding="14,5" Style="{StaticResource AccentButtonStyle}" Click="Install_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
