<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:glass="using:FilesMate.App.Controls.Glass" xmlns:settings="using:FilesMate.App.Controls.Settings" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FilesMate.App.Views.AppearancePage" SizeChanged="AppearancePage_SizeChanged">
    <StackPanel Spacing="20" x:Name="AppearanceRoot" MaxWidth="880" HorizontalAlignment="Left" Margin="24,0,24,24">
        <StackPanel Spacing="6">
            <TextBlock x:Name="Heading" Style="{StaticResource FilesMate.SettingsHeadingStyle}" Text="Appearance" />
            <TextBlock x:Name="Lead" Style="{StaticResource FilesMate.SettingsLeadStyle}" Text="Choose Light, Dark, or match Windows." />
            <TextBlock x:Name="ErrorText" Margin="0,0,0,12" Foreground="{ThemeResource FilesMate.Selection.AccentBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
        <StackPanel Spacing="12">
            <TextBlock x:Name="SkinHeader" Style="{StaticResource FilesMate.SettingsSectionHeaderStyle}" Margin="0" />
            <glass:LiquidGlassSurface Padding="16" Style="{StaticResource FilesMate.GlassCardStyle}">
                <StackPanel Spacing="12">
                    <settings:SettingCard x:Name="ThemeCard" Title="Theme" Description="Light, Dark, or match Windows." SizeChanged="ThemeCard_SizeChanged" ShowDivider="False">
                        <StackPanel x:Name="ThemeChipsHost" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ThemeSystem" HorizontalAlignment="Left" Click="ThemeSystem_Click" Style="{StaticResource ThemeChipButtonStyle}" AutomationProperties.Name="System theme" MinWidth="0" Padding="10,6" MinHeight="36">
                                <StackPanel Spacing="8" Orientation="Horizontal">
                                    <Border x:Name="ThemeSystemFrame" Width="20" Height="16" BorderBrush="{ThemeResource FilesMate.Glass.BorderStrongBrush}" BorderThickness="1" CornerRadius="{StaticResource FilesMate.Corner.Illustration}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{ThemeResource FilesMate.ThemePreview.LightFill}" CornerRadius="7,0,0,7" />
                                            <Border Grid.Column="1" Background="{ThemeResource FilesMate.ThemePreview.DarkFill}" CornerRadius="0,7,7,0" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="ThemeSystemLabel" HorizontalAlignment="Center" Text="System" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ThemeLight" HorizontalAlignment="Left" Click="ThemeLight_Click" Style="{StaticResource ThemeChipButtonStyle}" AutomationProperties.Name="Light theme" MinWidth="0" Padding="10,6" MinHeight="36">
                                <StackPanel Spacing="8" Orientation="Horizontal">
                                    <Border x:Name="ThemeLightFrame" Width="20" Height="16" RequestedTheme="Light" Background="{ThemeResource FilesMate.ThemePreview.LightFill}" BorderBrush="{ThemeResource FilesMate.ThemePreview.DarkFill}" BorderThickness="1" CornerRadius="{StaticResource FilesMate.Corner.Illustration}">
                                        <Grid>
                                            <Border Height="14" VerticalAlignment="Top" Background="{ThemeResource FilesMate.Text.SecondaryBrush}" CornerRadius="8,8,0,0" Opacity="0.28" />
                                            <Border Width="20" Margin="0,14,0,0" HorizontalAlignment="Left" Background="{ThemeResource FilesMate.Text.SecondaryBrush}" Opacity="0.14" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="ThemeLightLabel" HorizontalAlignment="Center" Text="Light" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ThemeDark" HorizontalAlignment="Left" Click="ThemeDark_Click" Style="{StaticResource ThemeChipButtonStyle}" AutomationProperties.Name="Dark theme" MinWidth="0" Padding="10,6" MinHeight="36">
                                <StackPanel Spacing="8" Orientation="Horizontal">
                                    <Border x:Name="ThemeDarkFrame" Width="20" Height="16" RequestedTheme="Dark" Background="{ThemeResource FilesMate.ThemePreview.DarkFill}" BorderBrush="{ThemeResource FilesMate.ThemePreview.LightFill}" BorderThickness="1" CornerRadius="{StaticResource FilesMate.Corner.Illustration}">
                                        <Grid>
                                            <Border Height="14" VerticalAlignment="Top" Background="{ThemeResource FilesMate.Text.SecondaryBrush}" CornerRadius="8,8,0,0" Opacity="0.28" />
                                            <Border Width="20" Margin="0,14,0,0" HorizontalAlignment="Left" Background="{ThemeResource FilesMate.Text.SecondaryBrush}" Opacity="0.14" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="ThemeDarkLabel" HorizontalAlignment="Center" Text="Dark" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </settings:SettingCard>
                    <TextBlock x:Name="SkinCurrentName" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{ThemeResource FilesMate.Text.PrimaryBrush}" />
                    <TextBlock x:Name="SkinLead" FontSize="12.5" TextWrapping="Wrap" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                    <TextBlock x:Name="SkinMessageText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                    <StackPanel Spacing="8" x:Name="SkinPrimaryActions" Orientation="Horizontal" Visibility="Collapsed" SizeChanged="SkinTools_SizeChanged">
                        <Button x:Name="SkinCancelButton" Click="SkinCancel_Click" MinHeight="36" Padding="12,6" HorizontalAlignment="Left" />
                        <Button x:Name="SkinApplyButton" Click="SkinApply_Click" MinHeight="36" Padding="12,6" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Grid x:Name="SkinPresetGrid" ColumnSpacing="10" RowSpacing="10" SizeChanged="SkinPresetGrid_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    </Grid>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="AccentHeader" Style="{StaticResource FilesMate.SettingsSectionHeaderStyle}" Text="Accent" Margin="0" />
                        <TextBlock x:Name="AccentLead" FontSize="12.5" Foreground="{ThemeResource FilesMate.Text.PrimaryBrush}" TextWrapping="Wrap" />
                        <Border x:Name="AccentPaletteCard" HorizontalAlignment="Stretch" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource FilesMate.Glass.BorderBrush}" Background="{ThemeResource FilesMate.Glass.SurfaceBrush}">
                            <StackPanel Spacing="12">
                                <Grid x:Name="AccentSummaryRow" ColumnSpacing="10" RowSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border x:Name="AccentCurrentColor" Width="36" Height="36" CornerRadius="8" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{ThemeResource FilesMate.Glass.BorderBrush}" />
                                    <StackPanel x:Name="AccentSummaryText" Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock x:Name="AccentCurrentName" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource FilesMate.Text.PrimaryBrush}" />
                                        <TextBlock x:Name="AccentCurrentHex" FontSize="12" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="AccentPaletteContent" ColumnSpacing="20" RowSpacing="14" SizeChanged="AccentPaletteContent_SizeChanged">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="184" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <settings:AccentSwatchPanel x:Name="AccentHost" MaxWidth="184" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <StackPanel x:Name="AccentPreviewPane" Grid.Column="1" Spacing="8">
                                        <TextBlock x:Name="SkinSampleLabel" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                                        <Border x:Name="SkinSampleHost" CornerRadius="8" />
                                        <TextBlock x:Name="SkinDerivedHint" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Expander x:Name="SkinAdvancedExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <TextBox x:Name="SkinNameBox" MaxLength="80" TextChanged="SkinNameBox_TextChanged" />
                            <Grid x:Name="SkinSelectors" ColumnSpacing="12" RowSpacing="12" SizeChanged="SkinSelectors_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox x:Name="SkinModeBox" HorizontalAlignment="Stretch" SelectionChanged="SkinModeBox_SelectionChanged">
                                    <ComboBoxItem x:Name="SkinLightItem" Tag="Light" />
                                    <ComboBoxItem x:Name="SkinDarkItem" Tag="Dark" />
                                </ComboBox>
                                <ComboBox x:Name="SkinRoleBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="SkinRoleBox_SelectionChanged">
                                    <ComboBoxItem x:Name="SkinAccentItem" Tag="Accent" />
                                    <ComboBoxItem x:Name="SkinBackgroundItem" Tag="Background" />
                                    <ComboBoxItem x:Name="SkinTextItem" Tag="Text" />
                                    <ComboBoxItem x:Name="SkinSelectionItem" Tag="Selection" />
                                </ComboBox>
                            </Grid>
                            <Grid x:Name="SkinEditorFields" ColumnSpacing="16" RowSpacing="14" SizeChanged="SkinEditorFields_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ColorPicker x:Name="SkinColorPicker" HorizontalAlignment="Left" MaxWidth="240" IsAlphaEnabled="False" IsAlphaSliderVisible="False" IsAlphaTextInputVisible="False" IsColorChannelTextInputVisible="False" IsHexInputVisible="False" IsMoreButtonVisible="False" ColorChanged="SkinColorPicker_ColorChanged" />
                                <StackPanel x:Name="SkinValueFields" Grid.Column="1" Spacing="10">
                                    <TextBox x:Name="SkinHexBox" MaxLength="7" TextChanged="SkinHexBox_TextChanged" />
                                    <Grid x:Name="SkinRgbFields" ColumnSpacing="8" RowSpacing="8" SizeChanged="SkinRgbFields_SizeChanged">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:Name="SkinRedBox" Header="R" Minimum="0" Maximum="255" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="SkinRgbBox_ValueChanged" MinWidth="0" Grid.Column="0" />
                                        <NumberBox x:Name="SkinGreenBox" Header="G" Minimum="0" Maximum="255" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="SkinRgbBox_ValueChanged" MinWidth="0" Grid.Column="1" />
                                        <NumberBox x:Name="SkinBlueBox" Header="B" Minimum="0" Maximum="255" SmallChange="1" SpinButtonPlacementMode="Compact" ValueChanged="SkinRgbBox_ValueChanged" MinWidth="0" Grid.Column="2" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="SkinUtilityActions" ColumnSpacing="16" RowSpacing="8" SizeChanged="SkinUtilityActions_SizeChanged">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="SkinHistoryActions" Spacing="8" Orientation="Horizontal" SizeChanged="SkinTools_SizeChanged">
                                    <Button x:Name="SkinResetButton" Click="SkinReset_Click" MinHeight="36" Padding="12,6" HorizontalAlignment="Left" />
                                    <Button x:Name="SkinRevertButton" Click="SkinRevert_Click" MinHeight="36" Padding="12,6" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel x:Name="SkinJsonActions" Grid.Column="1" Spacing="8" Orientation="Horizontal" HorizontalAlignment="Right" SizeChanged="SkinTools_SizeChanged">
                                    <Button x:Name="SkinImportButton" Click="SkinImport_Click" MinHeight="36" Padding="12,6" HorizontalAlignment="Left" />
                                    <Button x:Name="SkinExportButton" Click="SkinExport_Click" MinHeight="36" Padding="12,6" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <TextBlock x:Name="SkinContrastText" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" />

                </StackPanel>
            </glass:LiquidGlassSurface>
        </StackPanel>
        <StackPanel Spacing="12">
            <TextBlock x:Name="GlassHeader" Style="{StaticResource FilesMate.SettingsSectionHeaderStyle}" Margin="0" />
            <glass:LiquidGlassSurface Padding="16" Style="{StaticResource FilesMate.GlassCardStyle}">
                <StackPanel Spacing="0">
                    <settings:SettingCard x:Name="BackdropCard" Title="Backdrop" Description="Acrylic reveals the desktop through a softly tinted surface." ShowDivider="True">
                        <ComboBox x:Name="BackdropBox" MinWidth="0" MinHeight="34" CornerRadius="{StaticResource FilesMate.Corner.Small}" SelectionChanged="BackdropBox_SelectionChanged" MaxWidth="240">
                            <ComboBoxItem x:Name="BackdropAcrylicItem" Content="Acrylic" Tag="Acrylic" />
                            <ComboBoxItem x:Name="BackdropMicaItem" Content="Mica" Tag="Mica" />
                            <ComboBoxItem x:Name="BackdropMicaAltItem" Content="Mica Alt" Tag="MicaAlt" />
                            <ComboBoxItem x:Name="BackdropSolidItem" Content="Solid" Tag="Solid" />
                        </ComboBox>
                    </settings:SettingCard>
                    <settings:SettingCard x:Name="GlassEffectCard" Title="Glass effects" Description="Choose how transparent and layered the static glass surfaces appear." ShowDivider="True">
                        <ComboBox x:Name="GlassEffectBox" MinWidth="0" MinHeight="34" CornerRadius="{StaticResource FilesMate.Corner.Small}" SelectionChanged="GlassEffectBox_SelectionChanged" MaxWidth="240">
                            <ComboBoxItem x:Name="GlassEffectOffItem" Content="Off" Tag="Off" />
                            <ComboBoxItem x:Name="GlassEffectBalancedItem" Content="Balanced" Tag="Balanced" />
                            <ComboBoxItem x:Name="GlassEffectImmersiveItem" Content="Immersive" Tag="Immersive" />
                        </ComboBox>
                    </settings:SettingCard>
                    <settings:SettingCard x:Name="TransparencyCard" Title="Transparency" Description="Higher values reveal more of the background." ShowDivider="True" ActionPreferredWidth="280">
                        <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" MinWidth="42" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="TransparencySlider" Minimum="0" Maximum="100" StepFrequency="1" SmallChange="1" LargeChange="10" VerticalAlignment="Center" MinHeight="32" FontFamily="{ThemeResource FilesMate.UiFontFamily}" ValueChanged="TransparencySlider_ValueChanged" />
                            <TextBlock x:Name="TransparencyValue" Grid.Column="1" Text="0%" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </settings:SettingCard>
                    <settings:SettingCard x:Name="ReduceMotionCard" Title="Reduce motion" Description="On reduces animation. FilesMate cannot turn motion back on when Windows has it off.">
                        <ComboBox x:Name="ReduceMotionBox" MinWidth="0" MinHeight="34" CornerRadius="{StaticResource FilesMate.Corner.Small}" SelectionChanged="ReduceMotionBox_SelectionChanged" MaxWidth="240">
                            <ComboBoxItem x:Name="ReduceMotionSystemItem" Content="System" Tag="System" />
                            <ComboBoxItem x:Name="ReduceMotionOnItem" Content="On" Tag="On" />
                        </ComboBox>
                    </settings:SettingCard>
                </StackPanel>
            </glass:LiquidGlassSurface>
        </StackPanel>
        <StackPanel Spacing="12">
            <TextBlock x:Name="DisplayHeader" Style="{StaticResource FilesMate.SettingsSectionHeaderStyle}" Margin="0" />
            <glass:LiquidGlassSurface Padding="16" Style="{StaticResource FilesMate.GlassCardStyle}">
                <StackPanel Spacing="0">
                    <settings:SettingCard x:Name="FileIconsCard" ShowDivider="True">
                        <ToggleSwitch x:Name="FileIconsToggle" MinWidth="0" Toggled="FileIconsToggle_Toggled" />
                    </settings:SettingCard>
                    <settings:SettingCard x:Name="StatusBarCard" Title="Status bar" Description="Show the item count and selection summary under the file list." ShowDivider="True">
                        <ToggleSwitch x:Name="StatusBarToggle" MinWidth="0" OffContent="Off" OnContent="On" Toggled="StatusBarToggle_Toggled" />
                    </settings:SettingCard>
                    <settings:SettingCard x:Name="ToolbarCard" Title="Toolbar" Description="Show the command bar above the file list.">
                        <ToggleSwitch x:Name="ToolbarToggle" MinWidth="0" OffContent="Off" OnContent="On" Toggled="ToolbarToggle_Toggled" />
                    </settings:SettingCard>
                </StackPanel>
            </glass:LiquidGlassSurface>
        </StackPanel>
        <StackPanel Spacing="12">
            <TextBlock x:Name="FileTypographyHeader" Style="{StaticResource FilesMate.SettingsSectionHeaderStyle}" Margin="0" />
            <glass:LiquidGlassSurface x:Name="TypographyCard" Padding="16" Style="{StaticResource FilesMate.GlassCardStyle}">
                <StackPanel Spacing="12">
                    <Grid x:Name="TypographyFields" ColumnSpacing="24" RowSpacing="12" SizeChanged="TypographyFields_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="FileFontCard" Spacing="6">
                            <TextBlock x:Name="FileFontLabel" FontSize="13" FontWeight="SemiBold" />
                            <ComboBox x:Name="FileFontBox" HorizontalAlignment="Stretch" MaxDropDownHeight="320" IsTextSearchEnabled="True" SelectionChanged="FileTypography_Changed" />
                            <TextBlock x:Name="FileFontHint" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                        </StackPanel>
                        <Grid x:Name="TypographySizes" Grid.Column="1" ColumnSpacing="12" RowSpacing="10" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="FileNameSizeLabel" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <ComboBox x:Name="FileNameSizeBox" Grid.Column="1" Width="76" SelectionChanged="FileTypography_Changed" />
                            <TextBlock x:Name="FileDetailsSizeLabel" Grid.Row="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <ComboBox x:Name="FileDetailsSizeBox" Grid.Row="1" Grid.Column="1" Width="76" SelectionChanged="FileTypography_Changed" />
                        </Grid>
                    </Grid>
                    <Border Padding="12,10" CornerRadius="8" Background="{ThemeResource FilesMate.Item.HoverBrush}">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="FileFontPreview" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FileDetailsPreview" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource FilesMate.Text.SecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="ResetFileTypographyButton" HorizontalAlignment="Right" FontSize="12" Padding="10,5" Click="ResetFileTypography_Click" />
                </StackPanel>
            </glass:LiquidGlassSurface>
        </StackPanel>
    </StackPanel>
</UserControl>
