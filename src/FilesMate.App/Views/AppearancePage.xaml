<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="FilesMate.App.Views.AppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:glass="using:FilesMate.App.Controls.Glass"
    xmlns:settings="using:FilesMate.App.Controls.Settings">
    <StackPanel MaxWidth="720" Spacing="0">
        <TextBlock
            x:Name="Heading"
            Style="{StaticResource FilesMate.SettingsHeadingStyle}"
            Text="Appearance" />
        <TextBlock
            x:Name="Lead"
            Style="{StaticResource FilesMate.SettingsLeadStyle}"
            Text="Preview and apply Light, Dark, or Windows default." />
        <TextBlock
            x:Name="ErrorText"
            Margin="0,0,0,12"
            Foreground="{ThemeResource FilesMate.Selection.AccentBrush}"
            FontSize="12"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <TextBlock
            x:Name="DisplayHeader"
            Style="{StaticResource FilesMate.SectionHeaderStyle}"
            Text="Display" />
        <glass:LiquidGlassSurface Style="{StaticResource FilesMate.GlassCardStyle}" Padding="0">
            <StackPanel>
                <settings:SettingCard x:Name="FileIconsCard" ShowDivider="True">
                    <ToggleSwitch x:Name="FileIconsToggle" MinWidth="0" Toggled="FileIconsToggle_Toggled" />
                </settings:SettingCard>
                <settings:SettingCard
                    x:Name="ThemeCard"
                    Title="Theme"
                    Description="Light, Dark, or match Windows."
                    ShowDivider="True">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="ThemeSystem"
                            Click="ThemeSystem_Click"
                            Style="{StaticResource ThemeChipButtonStyle}"
                            AutomationProperties.Name="System theme">
                            <StackPanel Spacing="6">
                                <Border
                                    x:Name="ThemeSystemFrame"
                                    Width="96"
                                    Height="56"
                                    BorderBrush="{ThemeResource FilesMate.Glass.BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource FilesMate.Corner.Illustration}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Background="{ThemeResource FilesMate.ThemePreview.LightFill}"
                                            CornerRadius="7,0,0,7" />
                                        <Border
                                            Grid.Column="1"
                                            Background="{ThemeResource FilesMate.ThemePreview.DarkFill}"
                                            CornerRadius="0,7,7,0" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    x:Name="ThemeSystemLabel"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource FilesMate.Text.PrimaryBrush}"
                                    Text="System" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ThemeLight"
                            Click="ThemeLight_Click"
                            Style="{StaticResource ThemeChipButtonStyle}"
                            AutomationProperties.Name="Light theme">
                            <StackPanel Spacing="6">
                                <Border
                                    x:Name="ThemeLightFrame"
                                    Width="96"
                                    Height="56"
                                    RequestedTheme="Light"
                                    Background="{ThemeResource FilesMate.ThemePreview.LightFill}"
                                    BorderBrush="{ThemeResource FilesMate.ThemePreview.DarkFill}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource FilesMate.Corner.Illustration}">
                                    <Grid>
                                        <Border
                                            Height="14"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource FilesMate.Text.SecondaryBrush}"
                                            CornerRadius="8,8,0,0"
                                            Opacity="0.28" />
                                        <Border
                                            Width="20"
                                            Margin="0,14,0,0"
                                            HorizontalAlignment="Left"
                                            Background="{ThemeResource FilesMate.Text.SecondaryBrush}"
                                            Opacity="0.14" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    x:Name="ThemeLightLabel"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource FilesMate.Text.PrimaryBrush}"
                                    Text="Light" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="ThemeDark"
                            Click="ThemeDark_Click"
                            Style="{StaticResource ThemeChipButtonStyle}"
                            AutomationProperties.Name="Dark theme">
                            <StackPanel Spacing="6">
                                <Border
                                    x:Name="ThemeDarkFrame"
                                    Width="96"
                                    Height="56"
                                    RequestedTheme="Dark"
                                    Background="{ThemeResource FilesMate.ThemePreview.DarkFill}"
                                    BorderBrush="{ThemeResource FilesMate.ThemePreview.LightFill}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource FilesMate.Corner.Illustration}">
                                    <Grid>
                                        <Border
                                            Height="14"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource FilesMate.Text.SecondaryBrush}"
                                            CornerRadius="8,8,0,0"
                                            Opacity="0.28" />
                                        <Border
                                            Width="20"
                                            Margin="0,14,0,0"
                                            HorizontalAlignment="Left"
                                            Background="{ThemeResource FilesMate.Text.SecondaryBrush}"
                                            Opacity="0.14" />
                                    </Grid>
                                </Border>
                                <TextBlock
                                    x:Name="ThemeDarkLabel"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{ThemeResource FilesMate.Text.PrimaryBrush}"
                                    Text="Dark" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </settings:SettingCard>
                <settings:SettingCard
                    x:Name="ShellStyleCard"
                    Title="Interface style"
                    Description="A continuous surface or softly separated regions."
                    ShowDivider="True">
                    <ComboBox x:Name="ShellStyleBox" MinWidth="148" MinHeight="34"
                        CornerRadius="{StaticResource FilesMate.Corner.Small}"
                        SelectionChanged="ShellStyleBox_SelectionChanged">
                        <ComboBoxItem x:Name="ShellLayeredItem" Content="Layered" Tag="Layered" />
                        <ComboBoxItem x:Name="ShellUnifiedItem" Content="Unified" Tag="Unified" />
                    </ComboBox>
                </settings:SettingCard>
                <settings:SettingCard
                    x:Name="BackdropCard"
                    Title="Backdrop"
                    Description="Acrylic reveals the desktop through a softly tinted surface."
                    ShowDivider="True">
                    <ComboBox
                        x:Name="BackdropBox"
                        MinWidth="148"
                        MinHeight="34"
                        CornerRadius="{StaticResource FilesMate.Corner.Small}"
                        SelectionChanged="BackdropBox_SelectionChanged">
                        <ComboBoxItem x:Name="BackdropAcrylicItem" Content="Acrylic" Tag="Acrylic" />
                        <ComboBoxItem x:Name="BackdropMicaItem" Content="Mica" Tag="Mica" />
                        <ComboBoxItem x:Name="BackdropMicaAltItem" Content="Mica Alt" Tag="MicaAlt" />
                        <ComboBoxItem x:Name="BackdropSolidItem" Content="Solid" Tag="Solid" />
                    </ComboBox>
                </settings:SettingCard>
                <settings:SettingCard
                    x:Name="StatusBarCard"
                    Title="Status bar"
                    Description="Show the item count and selection summary under the file list."
                    ShowDivider="True">
                    <ToggleSwitch
                        x:Name="StatusBarToggle"
                        MinWidth="0"
                        OffContent="Off"
                        OnContent="On"
                        Toggled="StatusBarToggle_Toggled" />
                </settings:SettingCard>
                <settings:SettingCard
                    x:Name="ToolbarCard"
                    Title="Toolbar"
                    Description="Show the command bar above the file list.">
                    <ToggleSwitch
                        x:Name="ToolbarToggle"
                        MinWidth="0"
                        OffContent="Off"
                        OnContent="On"
                        Toggled="ToolbarToggle_Toggled" />
                </settings:SettingCard>
            </StackPanel>
        </glass:LiquidGlassSurface>
        <TextBlock
            x:Name="GlassHeader"
            Style="{StaticResource FilesMate.SettingsSectionHeaderStyle}"
            Text="Glass" />
        <glass:LiquidGlassSurface Style="{StaticResource FilesMate.GlassCardStyle}" Padding="0">
            <StackPanel>
                <settings:SettingCard
                    x:Name="GlassEffectCard"
                    Title="Glass effects"
                    Description="Choose how transparent and layered the static glass surfaces appear."
                    ShowDivider="True">
                    <ComboBox
                        x:Name="GlassEffectBox"
                        MinWidth="148"
                        MinHeight="34"
                        CornerRadius="{StaticResource FilesMate.Corner.Small}"
                        SelectionChanged="GlassEffectBox_SelectionChanged">
                        <ComboBoxItem x:Name="GlassEffectOffItem" Content="Off" Tag="Off" />
                        <ComboBoxItem x:Name="GlassEffectBalancedItem" Content="Balanced" Tag="Balanced" />
                        <ComboBoxItem x:Name="GlassEffectImmersiveItem" Content="Immersive" Tag="Immersive" />
                    </ComboBox>
                </settings:SettingCard>
                <settings:SettingCard
                    x:Name="TransparencyCard"
                    Title="Transparency"
                    Description="Higher values reveal more of the background."
                    ShowDivider="True">
                    <Grid Width="200" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="TransparencySlider" Minimum="0" Maximum="100" StepFrequency="1"
                                SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                                ValueChanged="TransparencySlider_ValueChanged" />
                        <TextBlock x:Name="TransparencyValue" Grid.Column="1" Text="18%"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </settings:SettingCard>
                <settings:SettingCard
                    x:Name="ReduceMotionCard"
                    Title="Reduce motion"
                    Description="On reduces animation. FilesMate cannot turn motion back on when Windows has it off.">
                    <ComboBox
                        x:Name="ReduceMotionBox"
                        MinWidth="148"
                        MinHeight="34"
                        CornerRadius="{StaticResource FilesMate.Corner.Small}"
                        SelectionChanged="ReduceMotionBox_SelectionChanged">
                        <ComboBoxItem x:Name="ReduceMotionSystemItem" Content="System" Tag="System" />
                        <ComboBoxItem x:Name="ReduceMotionOnItem" Content="On" Tag="On" />
                    </ComboBox>
                </settings:SettingCard>
            </StackPanel>
        </glass:LiquidGlassSurface>
        <TextBlock
            x:Name="AccentHeader"
            Style="{StaticResource FilesMate.SettingsSectionHeaderStyle}"
            Text="Accent" />
        <glass:LiquidGlassSurface Padding="16" Style="{StaticResource FilesMate.GlassCardStyle}">
            <StackPanel Spacing="10">
                <TextBlock
                    x:Name="AccentLead"
                    FontSize="12.5"
                    Foreground="{ThemeResource FilesMate.Text.PrimaryBrush}"
                    TextWrapping="Wrap" />
                <StackPanel x:Name="AccentHost" Spacing="8" />
            </StackPanel>
        </glass:LiquidGlassSurface>
    </StackPanel>
</UserControl>
