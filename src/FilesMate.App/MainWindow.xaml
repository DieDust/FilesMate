<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FilesMate.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:FilesMate.App.Localization"
    xmlns:glass="using:FilesMate.App.Controls.Glass"
    xmlns:input="using:FilesMate.App.Input"
    Title="FilesMate">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <input:ShellRoot
        Background="Transparent"
        KeyboardAcceleratorPlacementMode="Hidden">
        <input:ShellRoot.Resources>
            <Style x:Key="SolidShellRootStyle" TargetType="input:ShellRoot">
                <Setter Property="Background" Value="{ThemeResource FilesMate.App.SolidBackgroundBrush}" />
            </Style>
        </input:ShellRoot.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator x:Name="NewTabAccelerator" Key="T" Modifiers="Control" Invoked="NewTabAccelerator_Invoked" />
            <KeyboardAccelerator x:Name="CloseTabAccelerator" Key="W" Modifiers="Control" Invoked="CloseTabAccelerator_Invoked" />
            <KeyboardAccelerator x:Name="ReopenTabAccelerator" Key="T" Modifiers="Control,Shift" Invoked="ReopenTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="CloseSettingsAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <glass:LiquidGlassSurface
            x:Name="TitleBarGlass"
            Height="{StaticResource FilesMate.Control.Height.TitleBar}"
            Background="{ThemeResource FilesMate.Chrome.FillBrush}"
            BorderBrush="{ThemeResource FilesMate.Shell.SeparatorBrush}"
            BorderThickness="0,0,0,1"
            CornerRadius="0"
            SurfaceKind="Chrome"
            Style="{StaticResource FilesMate.LiquidGlassSurfaceStyle}">
            <Grid
                x:Name="AppTitleBar"
                LayoutUpdated="TitleBar_LayoutUpdated"
                Height="{StaticResource FilesMate.Control.Height.TitleBar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="BrandDragRegion"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Background="Transparent" />
                <Image
                    x:Name="BrandIcon"
                    Grid.Column="1"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Stretch="Uniform"
                    UseLayoutRounding="True">
                    <Image.Source>
                        <SvgImageSource
                            UriSource="ms-appx:///Assets/Branding/FilesMate.svg"
                            RasterizePixelWidth="20"
                            RasterizePixelHeight="20" />
                    </Image.Source>
                </Image>
                <TabView
                    x:Name="Tabs"
                    Grid.Column="3"
                    Height="{StaticResource FilesMate.Tab.Height}"
                    MinWidth="320"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    IsAddTabButtonVisible="False"
                    AllowDrop="True"
                    AllowDropTabs="True"
                    CanDragTabs="True"
                    CanReorderTabs="True"
                    CanTearOutTabs="False"
                    Style="{StaticResource FilesMateTabViewStyle}"
                    TabWidthMode="SizeToContent"
                    Loaded="Tabs_Loaded"
                    Loading="Tabs_Loading"
                    PointerEntered="Tabs_PointerEntered"
                    SelectionChanged="Tabs_SelectionChanged"
                    SizeChanged="Tabs_SizeChanged"
                    TabCloseRequested="Tabs_TabCloseRequested"
                    TabDragStarting="Tabs_TabDragStarting"
                    TabDragCompleted="Tabs_TabDragCompleted"
                    TabDroppedOutside="Tabs_TabDroppedOutside"
                    TabStripDragOver="Tabs_TabStripDragOver"
                    TabStripDrop="Tabs_TabStripDrop">
                    <TabView.Resources>
                        <!-- WinUI's default add-button container has a 3px bottom
                             padding, which makes the plus glyph visibly sink below
                             the tab labels. Keep the whole tab strip on one optical
                             baseline and make the button a real rounded control. -->
                        <Thickness x:Key="TabViewItemAddButtonContainerPadding">0</Thickness>
                        <x:Double x:Key="TabViewItemAddButtonWidth">36</x:Double>
                        <x:Double x:Key="TabViewItemAddButtonHeight">34</x:Double>
                        <x:Double x:Key="TabViewItemAddButtonFontSize">14</x:Double>
                        <StaticResource x:Key="ControlCornerRadius" ResourceKey="FilesMate.Corner.Small" />
                        <StaticResource x:Key="TabViewButtonBackground" ResourceKey="FilesMate.Glass.SurfaceBrush" />
                        <StaticResource x:Key="TabViewButtonBackgroundPointerOver" ResourceKey="FilesMate.Glass.SurfaceHoverBrush" />
                        <StaticResource x:Key="TabViewButtonBackgroundPressed" ResourceKey="FilesMate.Glass.SurfacePressedBrush" />
                        <StaticResource x:Key="TabViewButtonForeground" ResourceKey="FilesMate.Text.PrimaryBrush" />
                        <StaticResource x:Key="TabViewButtonForegroundPointerOver" ResourceKey="FilesMate.Text.PrimaryBrush" />
                        <StaticResource x:Key="TabViewButtonForegroundPressed" ResourceKey="FilesMate.Text.PrimaryBrush" />
                        <StaticResource x:Key="TabViewItemHeaderForeground" ResourceKey="FilesMate.Text.PrimaryBrush" />
                        <StaticResource x:Key="TabViewItemHeaderForegroundPointerOver" ResourceKey="FilesMate.Text.PrimaryBrush" />
                        <StaticResource x:Key="TabViewItemHeaderForegroundPressed" ResourceKey="FilesMate.Text.PrimaryBrush" />
                        <StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="FilesMate.Text.PrimaryBrush" />
                        <StaticResource x:Key="TabViewItemIconForeground" ResourceKey="FilesMate.Text.PrimaryBrush" />
                        <StaticResource x:Key="TabViewItemIconForegroundSelected" ResourceKey="FilesMate.Text.PrimaryBrush" />
                        <StaticResource x:Key="TabViewItemHeaderCloseButtonForeground" ResourceKey="FilesMate.Text.SecondaryBrush" />
                        <StaticResource x:Key="TabViewButtonBorderBrush" ResourceKey="FilesMate.Glass.BorderBrush" />
                        <StaticResource x:Key="TabViewButtonBorderBrushPointerOver" ResourceKey="FilesMate.Glass.BorderStrongBrush" />
                        <StaticResource x:Key="TabViewButtonBorderBrushPressed" ResourceKey="FilesMate.Glass.BorderStrongBrush" />
                    </TabView.Resources>
                    <TabView.TabStripFooter>
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="{StaticResource FilesMate.Tab.DragMinWidth}" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="NewTabButton"
                                Grid.Column="0"
                                Width="36"
                                Height="34"
                                Margin="0,0,2,0"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Click="NewTabButton_Click"
                                AutomationProperties.Name="New tab"
                                Style="{StaticResource ToolbarIconButtonStyle}"
                                ToolTipService.ToolTip="New tab">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="16"
                                    Foreground="{ThemeResource FilesMate.Text.PrimaryBrush}"
                                    Glyph="&#xE710;" />
                            </Button>
                            <Border
                                x:Name="TabDragRegion"
                                Grid.Column="1"
                                AllowDrop="True"
                                Background="Transparent"
                                DragOver="TabStripTail_DragOver"
                                DragLeave="TabStripTail_DragLeave"
                                Drop="TabStripTail_Drop" />
                        </Grid>
                    </TabView.TabStripFooter>
                </TabView>
                <Border
                    x:Name="CaptionPad"
                    Grid.Column="4"
                    Width="0"
                    Background="Transparent" />
            </Grid>
        </glass:LiquidGlassSurface>

        <ContentControl
            x:Name="TabHost"
            Grid.Row="1"
            AllowDrop="True"
            Background="Transparent"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            DragOver="TabHost_DragOver"
            Drop="TabHost_Drop">
            <ContentControl.ContentTransitions>
                <TransitionCollection />
            </ContentControl.ContentTransitions>
        </ContentControl>

        <Grid
            x:Name="SettingsOverlay"
            Grid.Row="1"
            Canvas.ZIndex="100"
            Background="{ThemeResource FilesMate.SettingsOverlay.ScrimBrush}"
            Visibility="Collapsed">
            <!-- Keep the material's antialiased edge outside the content clip.
                 Clipping coincident rounded outlines repeatedly leaves a fringe. -->
            <Grid
                x:Name="SettingsPanel"
                MaxWidth="1180"
                MaxHeight="780"
                Margin="28"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <glass:FrostedBackdrop
                    x:Name="SettingsBackdrop"
                    Visibility="{Binding Visibility, ElementName=SettingsOverlay}"
                    CornerRadius="16"
                    IsHitTestVisible="False" />
                <Border
                    Background="{ThemeResource FilesMate.LiquidGlass.TopSheenBrush}"
                    CornerRadius="16"
                    IsHitTestVisible="False" />
                <Grid x:Name="SettingsContentClip" Margin="1" CornerRadius="15">
                    <ContentControl
                        x:Name="SettingsHost"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="Transparent"
                        Foreground="{ThemeResource FilesMate.Text.PrimaryBrush}" />
                </Grid>
                <Border
                    BorderBrush="{ThemeResource FilesMate.Card.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </input:ShellRoot>
</Window>
