                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource FilesMate.Glass.BorderStrongBrush}" />
                                    <Setter Target="Root.Background" Value="{ThemeResource FilesMate.Button.HoverBrush}" /><Setter Target="ButtonContent.Foreground" Value="{ThemeResource FilesMate.Button.ActiveForegroundBrush}" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        
                                    <Setter Target="Root.Background" Value="{ThemeResource FilesMate.Button.PressedBrush}" /><Setter Target="ButtonContent.Foreground" Value="{ThemeResource FilesMate.Button.ActiveForegroundBrush}" /></VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonContent.Foreground" Value="{ThemeResource FilesMate.Text.DisabledBrush}" /><Setter Target="Root.Background" Value="{ThemeResource ButtonBackgroundDisabled}" /><Setter Target="Root.BorderBrush" Value="{ThemeResource FilesMate.Text.DisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryCommandButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="FontFamily" Value="{ThemeResource FilesMate.UiFontFamily}" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Height" Value="{StaticResource FilesMate.Control.Height.Row}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="{StaticResource FilesMate.Corner.Small}" />
    </Style>
</ResourceDictionary>
