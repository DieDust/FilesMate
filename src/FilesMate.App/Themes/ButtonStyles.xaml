    <Style
        x:Key="GlassButtonStyle"
        BasedOn="{StaticResource QuietButtonStyle}"
        TargetType="Button">
        <Setter Property="FontFamily" Value="{ThemeResource FilesMate.UiFontFamily}" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="MinHeight" Value="34" />
