<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/TabBarStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="TabViewBorderBrush" Color="Transparent" />
    <Thickness x:Key="TabViewItemBorderThickness">1</Thickness>
    <x:Double x:Key="TabViewItemHeaderCloseButtonWidth">32</x:Double>
    <x:Double x:Key="TabViewItemHeaderCloseButtonHeight">32</x:Double>
    <StaticResource x:Key="TabViewItemCornerRadius" ResourceKey="FilesMate.Corner.Omnibar" />
    <StaticResource x:Key="FilesMate.Tab.SelectedCornerRadius" ResourceKey="FilesMate.Corner.Omnibar" />
    <Thickness x:Key="TabViewSelectedItemHeaderMargin">0</Thickness>
    <Thickness x:Key="TabViewSelectedItemBorderThickness">1</Thickness>
    <Thickness x:Key="TabViewItemHeaderPadding">12,0,12,0</Thickness>
    <Thickness x:Key="TabViewSelectedItemHeaderPadding">12,0,12,0</Thickness>
    <x:Double x:Key="TabViewItemMinWidth">120</x:Double>
    <x:Double x:Key="TabViewItemMaxWidth">240</x:Double>
    <x:Double x:Key="TabViewItemHeaderMinHeight">34</x:Double>
    <Thickness x:Key="TabViewHeaderPadding">0</Thickness>
    <!-- Match MainWindow's DPI-aware 16 DIP icon rasterization. One gap owns
         icon-to-label spacing for folder glyphs and the loading indicator. -->
    <x:Double x:Key="TabViewItemHeaderIconSize">16</x:Double>
    <Thickness x:Key="TabViewItemHeaderIconMargin">0,0,6,0</Thickness>
    <GridLength x:Key="FilesMate.Tab.IconSlotWidth">22</GridLength>
    <Thickness x:Key="TabViewItemHeaderCloseMargin">4,0,0,0</Thickness>
    <GridLength x:Key="FilesMate.Tab.CloseSlotWidth">36</GridLength>

    <Style x:Key="FilesMateTabViewStyle" TargetType="TabView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="IsAddTabButtonVisible" Value="True" />
        <Setter Property="TabWidthMode" Value="SizeToContent" />
        <Setter Property="CloseButtonOverlayMode" Value="OnPointerOver" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Transitions">
            <Setter.Value>
                <TransitionCollection />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- An explicit font-only style opts this label out of the app TextBlock ink.
         Its foreground must inherit the presenter's current selected/hover/disabled state. -->
    <Style x:Key="FilesMate.Tab.HeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource FilesMate.UiFontFamily}" />
    </Style>

    <Style
        x:Key="FilesMateTabViewItemStyle"
        BasedOn="{StaticResource TabBarItemStyle}"
        TargetType="TabViewItem">
        <Setter Property="MinWidth" Value="{StaticResource FilesMate.Tab.MinWidth}" />
        <Setter Property="MaxWidth" Value="{StaticResource FilesMate.Tab.MaxWidth}" />
        <Setter Property="CornerRadius" Value="{StaticResource FilesMate.Corner.Omnibar}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource FilesMate.Text.PrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Transitions">
            <Setter.Value>
                <TransitionCollection />
            </Setter.Value>
        </Setter>
        <Setter Property="ContentTransitions">
            <Setter.Value>
                <TransitionCollection />
            </Setter.Value>
        </Setter>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock
                        HighContrastAdjustment="None"
                        Style="{StaticResource FilesMate.Tab.HeaderTextStyle}"
                        Text="{Binding}"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource FilesMateTabViewItemStyle}" TargetType="TabViewItem" />
</ResourceDictionary>
