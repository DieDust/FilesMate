<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:glass="using:FilesMate.App.Controls.Glass">
    <ThemeShadow x:Key="FilesMate.LiquidGlass.ThemeShadow" />

    <Style
        x:Key="FilesMate.LiquidGlassSurfaceStyle"
        TargetType="glass:LiquidGlassSurface">
        <Setter Property="Background" Value="{ThemeResource FilesMate.LiquidGlass.FillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource FilesMate.LiquidGlass.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource FilesMate.Corner.Card}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Shadow" Value="{StaticResource FilesMate.LiquidGlass.ThemeShadow}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="glass:LiquidGlassSurface">
                    <Grid
                        x:Name="Root"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Border
                            x:Name="PART_SolidLayer"
                            Background="{ThemeResource FilesMate.LiquidGlass.SolidFillBrush}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <Border
                            x:Name="PART_MaterialLayer"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="PART_InnerHighlight"
                            BorderBrush="{ThemeResource FilesMate.LiquidGlass.InnerHighlightBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False" />
                        <Border
                            x:Name="PART_StaticSheen"
                            Background="{ThemeResource FilesMate.LiquidGlass.TopSheenBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False" />
                        <ContentPresenter
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
