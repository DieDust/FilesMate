<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:glass="using:FilesMate.App.Controls.Glass">
    <Style
        x:Key="SidebarItemStyle"
        TargetType="Button">
        <Setter Property="FontFamily" Value="{ThemeResource FilesMate.UiFontFamily}" />
        <Setter Property="Foreground" Value="{ThemeResource FilesMate.Text.PrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="{StaticResource FilesMate.Control.Height.SidebarItem}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource FilesMate.Corner.Small}" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        VisualStateManager.CustomVisualStateManager="{StaticResource FilesMate.Motion.VisualStateManager}"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Border
                            x:Name="HoverSurface"
                            Background="{ThemeResource FilesMate.Button.HoverBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <ContentPresenter
                            x:Name="SidebarContent"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}" />
                        <Border
                            x:Name="FocusRing"
                            BorderBrush="{ThemeResource FilesMate.Selection.AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverSurface"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="{StaticResource FilesMate.Motion.Hover}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="SidebarContent.Foreground" Value="{ThemeResource FilesMate.Button.ActiveForegroundBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverSurface"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="{StaticResource FilesMate.Motion.Hover}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverSurface.Background" Value="{ThemeResource FilesMate.Button.PressedBrush}" />
                                        <Setter Target="SidebarContent.Foreground" Value="{ThemeResource FilesMate.Button.ActiveForegroundBrush}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverSurface"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="{StaticResource FilesMate.Motion.Hover}" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="SidebarContent.Foreground" Value="{ThemeResource FilesMate.Text.DisabledBrush}" />
                                        <Setter Target="Root.Background" Value="{ThemeResource ButtonBackgroundDisabled}" />
                                        <Setter Target="HoverSurface.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarPlaceItemStyle" TargetType="ListViewItem">
        <Setter Property="FontFamily" Value="{ThemeResource FilesMate.UiFontFamily}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="MinHeight" Value="{StaticResource FilesMate.Control.Height.SidebarItem}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="CornerRadius" Value="{StaticResource FilesMate.Corner.Small}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ListViewItemPresenter
                        x:Name="PlacePresenter"
                        Background="Transparent"
                        Foreground="{TemplateBinding Foreground}"
                        DisabledOpacity="1"
                        ContentMargin="0"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        DragBackground="{ThemeResource FilesMate.Item.SelectedBrush}"
                        DragForeground="{ThemeResource FilesMate.FileItem.SelectedForegroundBrush}"
                        HorizontalContentAlignment="Stretch"
                        PlaceholderBackground="Transparent"
                        PointerOverBackground="{ThemeResource FilesMate.Button.HoverBrush}"
                        PointerOverForeground="{TemplateBinding Foreground}"
                        PressedBackground="{ThemeResource FilesMate.Button.PressedBrush}"
                        SelectedBackground="Transparent"
                        SelectedPointerOverBackground="{ThemeResource FilesMate.Item.HoverBrush}"
                        SelectedPressedBackground="{ThemeResource FilesMate.Item.SelectedBrush}"
                        SelectionCheckMarkVisualEnabled="False"
                        VerticalContentAlignment="Stretch">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Selected" />
                                <!-- Current navigation is model-selected rather than
                                     ListView-selected. Preserve its paired ink during
                                     native hover/press states as well as normal. -->
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="PointerOverSelected" />
                                <VisualState x:Name="PointerOverPressed" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="PressedSelected" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DisabledStates">
                                <VisualState x:Name="Enabled" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PlacePresenter.Foreground" Value="{ThemeResource FilesMate.Text.DisabledBrush}" />
                                        <Setter Target="PlacePresenter.PointerOverForeground" Value="{ThemeResource FilesMate.Text.DisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </ListViewItemPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarPlaceListStyle" TargetType="ListView">
        <Setter Property="FontFamily" Value="{ThemeResource FilesMate.UiFontFamily}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="IsItemClickEnabled" Value="True" />
        <Setter Property="IsSwipeEnabled" Value="False" />
        <Setter Property="ShowsScrollingPlaceholders" Value="False" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SidebarPlaceItemStyle}" />
        <Setter Property="ItemContainerTransitions">
            <Setter.Value>
                <TransitionCollection />
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Setter.Value>
                <TransitionCollection />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarSectionItemStyle" TargetType="ListViewItem">
        <Setter Property="FontFamily" Value="{ThemeResource FilesMate.UiFontFamily}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <ListViewItemPresenter
                        Background="Transparent"
                        ContentMargin="0"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        DragBackground="{ThemeResource FilesMate.Item.SelectedBrush}"
                        HorizontalContentAlignment="Stretch"
                        PlaceholderBackground="Transparent"
                        PointerOverBackground="Transparent"
                        PressedBackground="Transparent"
                        SelectedBackground="Transparent"
                        SelectedPointerOverBackground="Transparent"
                        SelectedPressedBackground="Transparent"
                        SelectionCheckMarkVisualEnabled="False"
                        VerticalContentAlignment="Stretch" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SidebarSectionListStyle" TargetType="ListView">
        <Setter Property="FontFamily" Value="{ThemeResource FilesMate.UiFontFamily}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="IsItemClickEnabled" Value="False" />
        <Setter Property="IsSwipeEnabled" Value="False" />
        <Setter Property="ShowsScrollingPlaceholders" Value="False" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SidebarSectionItemStyle}" />
        <Setter Property="ItemContainerTransitions">
            <Setter.Value>
                <TransitionCollection />
            </Setter.Value>
        </Setter>
        <Setter Property="Transitions">
            <Setter.Value>
                <TransitionCollection />
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FilesMate.SettingsNavItemStyle" TargetType="ListViewItem">
        <Setter Property="FontFamily" Value="{ThemeResource FilesMate.UiFontFamily}" />
        <Setter Property="Foreground" Value="{ThemeResource FilesMate.Text.PrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="{StaticResource FilesMate.Corner.Small}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource FilesMate.Button.HoverBrush}" />
                                    
                                        <Setter Target="SettingsContent.Foreground" Value="{ThemeResource FilesMate.Button.ActiveForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource FilesMate.Button.HoverBrush}" />
                                    
                                        <Setter Target="SettingsContent.Foreground" Value="{ThemeResource FilesMate.Button.ActiveForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource FilesMate.Button.HoverBrush}" />
                                        <Setter Target="AccentMark.Opacity" Value="1" />
                                    
                                        <Setter Target="SettingsContent.Foreground" Value="{ThemeResource FilesMate.Button.ActiveForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource FilesMate.Button.HoverBrush}" />
                                        <Setter Target="AccentMark.Opacity" Value="1" />
                                    
                                        <Setter Target="SettingsContent.Foreground" Value="{ThemeResource FilesMate.Button.ActiveForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource FilesMate.Button.HoverBrush}" />
                                        <Setter Target="AccentMark.Opacity" Value="1" />
                                    
                                        <Setter Target="SettingsContent.Foreground" Value="{ThemeResource FilesMate.Button.ActiveForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource FilesMate.App.SolidBackgroundBrush}" />
                                        <Setter Target="AccentMark.Opacity" Value="0" />
                                    
                                        <Setter Target="SettingsContent.Foreground" Value="{ThemeResource FilesMate.Text.DisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="AccentMark"
                            Width="3"
                            Height="16"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{ThemeResource FilesMate.Selection.AccentBrush}"
                            CornerRadius="2"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <ContentPresenter
                            x:Name="SettingsContent"
                            Foreground="{TemplateBinding Foreground}"
                            Margin="6,0,0,0"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <Border
                            x:Name="FocusRing"
                            BorderBrush="{Binding Foreground, ElementName=SettingsContent}"
                            BorderThickness="1"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsHitTestVisible="False"
                            Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="FilesMate.CommandBarCardStyle"
        BasedOn="{StaticResource FilesMate.LiquidGlassSurfaceStyle}"
        TargetType="glass:LiquidGlassSurface">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource FilesMate.Divider.Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Shadow" Value="{x:Null}" />
        <Setter Property="SurfaceKind" Value="Command" />
    </Style>
</ResourceDictionary>
