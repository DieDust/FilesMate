<Window x:Class="FilesMate.SearchHost.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:FilesMate.SearchHost"
        Title="{loc:LocalizedText Key=Search_WindowTitle}" Width="660" SizeToContent="Height" MaxHeight="590"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_KeyDown" Deactivated="Window_Deactivated">
    <Window.Resources>
        <Style x:Key="PreviewResizeHandle" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Panel.ZIndex" Value="10"/>
            <Setter Property="Grid.RowSpan" Value="3"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
            <EventSetter Event="DragStarted" Handler="PreviewResize_Started"/>
            <EventSetter Event="DragDelta" Handler="PreviewResize_Delta"/>
            <EventSetter Event="DragCompleted" Handler="PreviewResize_Completed"/>
        </Style>
        <SolidColorBrush x:Key="Surface" Color="#24272E"/>
        <SolidColorBrush x:Key="MenuSurface" Color="#2C2C2E"/>
        <SolidColorBrush x:Key="Ink" Color="#F4F6FA"/>
        <SolidColorBrush x:Key="Muted" Color="#AEB8CA"/>
        <SolidColorBrush x:Key="Line" Color="#444B59"/>
        <SolidColorBrush x:Key="Selected" Color="#354969"/>
        <SolidColorBrush x:Key="SelectedInk" Color="#F4F6FA"/>
        <SolidColorBrush x:Key="SelectedMuted" Color="#AEB8CA"/>
        <SolidColorBrush x:Key="Hover" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="Accent" Color="#0A84FF"/>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Hover}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="RankRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Track" Background="{DynamicResource Line}" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Muted}">
                    <Ellipse x:Name="Thumb" Fill="{DynamicResource Ink}" Width="16" Height="16" Margin="3" HorizontalAlignment="Left"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Thumb" Property="Fill" Value="White"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Segment" TargetType="RadioButton">
            <EventSetter Event="Loaded" Handler="Interaction_Changed"/>
            <EventSetter Event="MouseEnter" Handler="Interaction_Changed"/>
            <EventSetter Event="MouseLeave" Handler="Interaction_Changed"/>
            <EventSetter Event="Checked" Handler="Interaction_Changed"/>
            <EventSetter Event="Unchecked" Handler="Interaction_Changed"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Grid Background="Transparent">
                    <Border x:Name="InteractionHover" CornerRadius="7" Background="{DynamicResource Hover}" Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="InteractionSelection" CornerRadius="7" Background="{DynamicResource Selected}" Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="SegmentBody" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                </Grid>
                <ControlTemplate.Triggers>

                    <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SegmentBody" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SecondaryResult" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SelectedMuted}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12,8" MaxWidth="600"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"
                       Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                    <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb x:Name="Grip" MinHeight="24"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Width="4" HorizontalAlignment="Center" Background="{DynamicResource Muted}" Opacity="0.45" CornerRadius="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                </Track>
                <ControlTemplate.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/>
                        <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/>
                        <Setter TargetName="Grip" Property="MinHeight" Value="0"/>
                        <Setter TargetName="Grip" Property="MinWidth" Value="24"/>
                        <Setter TargetName="Grip" Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Height="4" VerticalAlignment="Center" Background="{DynamicResource Muted}" Opacity="0.45" CornerRadius="2"/></ControlTemplate></Setter.Value></Setter>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="6"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="PreviewScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
                <Grid Background="{TemplateBinding Background}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/>
                    <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource {x:Type ScrollBar}}" Grid.Column="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    <ScrollBar x:Name="PART_HorizontalScrollBar" Style="{StaticResource {x:Type ScrollBar}}" Grid.Row="1" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button">
            <EventSetter Event="Loaded" Handler="Interaction_Changed"/>
            <EventSetter Event="MouseEnter" Handler="Interaction_Changed"/>
            <EventSetter Event="MouseLeave" Handler="Interaction_Changed"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Background="Transparent">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
                    <Border x:Name="InteractionHover" Background="{DynamicResource Hover}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="ButtonBorder" BorderThickness="1" BorderBrush="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                </Grid>
                <ControlTemplate.Triggers>

                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Selected}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Background="Transparent">
                    <Border x:Name="InteractionHover" Background="{DynamicResource CloseHover}" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="CloseBody" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource CloseInk}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseBody" Property="Background" Value="{DynamicResource ClosePressed}"/><Setter Property="Foreground" Value="{DynamicResource CloseInk}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CloseBody" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="RevealButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanLocate}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="1"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBoxItem">
            <EventSetter Event="Loaded" Handler="Interaction_Changed"/>
            <EventSetter Event="MouseEnter" Handler="Interaction_Changed"/>
            <EventSetter Event="MouseLeave" Handler="Interaction_Changed"/>
            <EventSetter Event="Selected" Handler="Interaction_Changed"/>
            <EventSetter Event="Unselected" Handler="Interaction_Changed"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Grid Background="Transparent">
                    <Border x:Name="InteractionHover" Background="{DynamicResource Hover}" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="InteractionSelection" Background="{DynamicResource Selected}" CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                    <Border x:Name="RowBorder" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                </Grid>
                <ControlTemplate.Triggers>

                    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource SelectedInk}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="Background" Value="{DynamicResource MenuSurface}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                <Border CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="6" MinWidth="248"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Grid><Border x:Name="MenuBody" CornerRadius="8" Padding="10,8" Background="Transparent"><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ContentPresenter ContentSource="Icon" VerticalAlignment="Center"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="22,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Chevron" Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="11" Margin="12,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                </Grid></Border>
                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" PlacementTarget="{Binding ElementName=MenuBody}">
                    <Border CornerRadius="10" Background="{DynamicResource MenuSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="5" MinWidth="180"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border>
                </Popup></Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="HasItems" Value="True"><Setter TargetName="Chevron" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuBody" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuBody" Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FileMenuToolbar" TargetType="MenuItem">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><ContentPresenter ContentSource="Header"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource Line}" Margin="8,4"/></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Border x:Name="Shell" Padding="12" CornerRadius="20" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource GlassSurface}">
        <StackPanel x:Name="PanelBody">
            <Grid x:Name="SearchHeader" Margin="10,1,2,1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="21" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                <Grid Grid.Column="1" Margin="0,4,6,4">
                    <TextBlock x:Name="Placeholder" Text="{loc:LocalizedText Key=Search_QueryHint}" FontSize="20" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox x:Name="QueryBox" AutomationProperties.AutomationId="GlobalSearchQuery" AutomationProperties.Name="{loc:LocalizedText Key=Search_AllIndexed}"
                             Background="Transparent" Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Ink}" SelectionBrush="{DynamicResource Accent}" BorderThickness="0" FontSize="20"
                             VerticalContentAlignment="Center" Padding="0" MinHeight="38" TextChanged="Query_Changed" MaxLength="256">
                        <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Background="Transparent" Focusable="False"/></ControlTemplate></TextBox.Template>
                    </TextBox>
                </Grid>
                <Button x:Name="ClearButton" Grid.Column="2" Width="48" Content="{loc:LocalizedText Key=Clear}" FontSize="12" Foreground="{DynamicResource Muted}" Visibility="Collapsed" ToolTip="{loc:LocalizedText Key=Search_ClearQuery}" AutomationProperties.Name="{loc:LocalizedText Key=Search_ClearQuery}" Click="Clear_Click" Padding="7,6"/>
                <Button Grid.Column="3" Content="&#xE713;" FontFamily="Segoe Fluent Icons" ToolTip="{loc:LocalizedText Key=Search_Settings}" AutomationProperties.Name="{loc:LocalizedText Key=Search_Settings}" Click="Settings_Click"/>
                <Button Grid.Column="4" Content="&#xE711;" Style="{StaticResource CloseButton}" FontFamily="Segoe Fluent Icons" ToolTip="{loc:LocalizedText Key=Search_HideEscape}" AutomationProperties.Name="{loc:LocalizedText Key=Search_Hide}" Click="Dismiss_Click"/>
            </Grid>
            <ProgressBar x:Name="SearchActivity" Height="2" Margin="10,2,10,0" Visibility="Hidden" IsHitTestVisible="False" Focusable="False" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Accent}" Value="40"/>
            <Grid x:Name="SearchPanel" Visibility="Collapsed" Margin="0,6,0,0" ClipToBounds="True">
                <StackPanel>
                    <DockPanel x:Name="FilterBar" Margin="4,0,8,8" Visibility="Collapsed">
                        <TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        <ScrollViewer MaxHeight="76" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="CategoryButtons"/></ScrollViewer>
                    </DockPanel>
                    <Grid x:Name="ResultBody">
                    <ListBox x:Name="Results" SelectionChanged="Preview_SelectionChanged" AutomationProperties.AutomationId="GlobalSearchResults" Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0"
                             MaxHeight="372" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Extended" ScrollViewer.ScrollChanged="Results_ScrollChanged" PreviewMouseWheel="Results_MouseWheel" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="Results_DoubleClick" PreviewMouseDown="Results_PreviewMouseDown" PreviewMouseLeftButtonUp="Results_MouseUp" MouseMove="Results_MouseMove" ContextMenuOpening="Results_ContextMenuOpening">
                        <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="45"/><ColumnDefinition Width="34"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Location}" Style="{StaticResource SecondaryResult}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Kind}" FontSize="10" Style="{StaticResource SecondaryResult}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="3" Style="{StaticResource RevealButton}" Content="&#xE8B7;" FontFamily="Segoe Fluent Icons" Padding="6" Click="Reveal_Click" ToolTip="{loc:LocalizedText Key=RevealFileShortcut}" AutomationProperties.Name="{loc:LocalizedText Key=RevealFile}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                <Button Grid.Column="4" Style="{StaticResource RevealButton}" Content="&#xE8C8;" FontFamily="Segoe Fluent Icons" Padding="6" Click="CopyPath_Click" ToolTip="{loc:LocalizedText Key=CopyFullPathShortcut}" AutomationProperties.Name="{loc:LocalizedText Key=CopyFullPath}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Popup x:Name="PreviewPopup" Placement="Right" PlacementTarget="{Binding ElementName=ResultBody}" HorizontalOffset="30" AllowsTransparency="False" StaysOpen="True" PopupAnimation="None">
                    <Border x:Name="PreviewCard" PreviewKeyDown="Window_KeyDown" Width="400" Visibility="Collapsed" Padding="16" CornerRadius="16" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="PreviewTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button x:Name="CompatiblePreviewButton" Grid.Column="1" Content="{loc:LocalizedText Key=PreviewCompatible}" Visibility="Collapsed" Padding="8,4" Margin="8,0" Click="CompatiblePreview_Click"/>
                                <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource CloseButton}" FontFamily="Segoe Fluent Icons" Padding="4" Click="Preview_Close" ToolTip="{loc:LocalizedText Key=Preview_Collapse}" AutomationProperties.Name="{loc:LocalizedText Key=Preview_Collapse}"/>
                            </Grid>
                            <Grid Grid.Row="1" x:Name="PreviewContentHost">
                                <ContentControl x:Name="PreviewTextHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                                <Image x:Name="PreviewImage" Visibility="Collapsed" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="PreviewMessage" Text="{loc:LocalizedText Key=Preview_Loading}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="PreviewNote" Grid.Row="2" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
                            <Thumb Tag="L" Style="{StaticResource PreviewResizeHandle}" Width="8" HorizontalAlignment="Left" Margin="-16,0,0,0" Cursor="SizeWE" AutomationProperties.Name="{loc:LocalizedText Key=Preview_ResizeLeft}"/>
                            <Thumb Tag="R" Style="{StaticResource PreviewResizeHandle}" Width="8" HorizontalAlignment="Right" Margin="0,0,-16,0" Cursor="SizeWE" AutomationProperties.Name="{loc:LocalizedText Key=Preview_ResizeRight}"/>
                            <Thumb Tag="T" Style="{StaticResource PreviewResizeHandle}" Height="8" VerticalAlignment="Top" Margin="0,-16,0,0" Cursor="SizeNS" AutomationProperties.Name="{loc:LocalizedText Key=Preview_ResizeTop}"/>
                            <Thumb Tag="B" Style="{StaticResource PreviewResizeHandle}" Height="8" VerticalAlignment="Bottom" Margin="0,0,0,-16" Cursor="SizeNS" AutomationProperties.Name="{loc:LocalizedText Key=Preview_ResizeBottom}"/>
                            <Thumb Tag="LT" Style="{StaticResource PreviewResizeHandle}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-16,-16,0,0" Cursor="SizeNWSE" AutomationProperties.Name="{loc:LocalizedText Key=Preview_ResizeTopLeft}"/>
                            <Thumb Tag="RT" Style="{StaticResource PreviewResizeHandle}" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-16,-16,0" Cursor="SizeNESW" AutomationProperties.Name="{loc:LocalizedText Key=Preview_ResizeTopRight}"/>
                            <Thumb Tag="LB" Style="{StaticResource PreviewResizeHandle}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-16,0,0,-16" Cursor="SizeNESW" AutomationProperties.Name="{loc:LocalizedText Key=Preview_ResizeBottomLeft}"/>
                            <Thumb Tag="RB" Style="{StaticResource PreviewResizeHandle}" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-16,-16" Cursor="SizeNWSE" AutomationProperties.Name="{loc:LocalizedText Key=Preview_ResizeBottomRight}"/>
                        </Grid>
                    </Border>
                    </Popup>
                    </Grid>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="12,8,12,8"/>
                    <Button x:Name="IndexHelpButton" Content="{loc:LocalizedText Key=Search_CheckIndex}" Visibility="Collapsed" HorizontalAlignment="Left" Margin="4,0,0,4" Click="ManageIndex_Click"/>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="CategoriesPanel" Visibility="Collapsed" Margin="4">
                <StackPanel.Resources><Style TargetType="TextBox">
                    <Setter Property="Background" Value="{DynamicResource Hover}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="CaretBrush" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border></ControlTemplate></Setter.Value></Setter>
                </Style></StackPanel.Resources>
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="&#xE72B;" FontFamily="Segoe Fluent Icons" Click="Categories_Back" ToolTip="{loc:LocalizedText Key=BackToSettings}"/>
                    <TextBlock Grid.Column="1" Text="{loc:LocalizedText Key=Category_Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" Content="{loc:LocalizedText Key=Shortcut_RestoreDefaults}" Click="Categories_Reset"/>
                </Grid>
                <TextBlock Text="{loc:LocalizedText Key=Category_EditHint}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="10,0,0,12"/>
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CategoryEditors"/></ScrollViewer>
                <Border Style="{StaticResource SettingsCard}" Margin="0,10,0,0"><StackPanel>
                    <TextBlock Text="{loc:LocalizedText Key=Category_AddCustom}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{loc:LocalizedText Key=Sort_Name}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/>
                        <TextBlock Grid.Column="1" Text="{loc:LocalizedText Key=FileExtensions}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,5"/>
                        <TextBox x:Name="CategoryName" Grid.Row="1" MaxLength="24" Margin="0,0,8,0" ToolTip="{loc:LocalizedText Key=Category_NameExample}" AutomationProperties.Name="{loc:LocalizedText Key=Category_Name}"/>
                        <TextBox x:Name="CategoryExtensions" Grid.Row="1" Grid.Column="1" MaxLength="1024" ToolTip="{loc:LocalizedText Key=Category_ExtensionsExampleLong}" AutomationProperties.Name="{loc:LocalizedText Key=FileExtensions}"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="{loc:LocalizedText Key=Add}" Click="Category_Add"/>
                    </Grid>
                    <TextBlock Text="{loc:LocalizedText Key=Category_ExtensionsHint}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel></Border>
                <TextBlock x:Name="CategoryStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="10,6,0,0"/>
            </StackPanel>
            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="4">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                </StackPanel.Resources>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                    <Button Content="&#xE72B;" FontFamily="Segoe Fluent Icons" Click="Settings_Click" ToolTip="{loc:LocalizedText Key=BackToSearch}" AutomationProperties.Name="{loc:LocalizedText Key=BackToSearch}"/>
                    <TextBlock Grid.Column="1" Text="{loc:LocalizedText Key=Search_Settings}" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource CloseButton}" FontFamily="Segoe Fluent Icons" Click="Dismiss_Click" AutomationProperties.Name="{loc:LocalizedText Key=HideSettings}"/>
                </Grid>
                <ScrollViewer x:Name="SearchSettingsScroll" MaxHeight="430" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <Border Style="{StaticResource SettingsCard}"><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{loc:LocalizedText Key=FilePreview}"/><TextBlock Text="{loc:LocalizedText Key=Search_PreviewCompactHint}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
                    <ToggleButton x:Name="PreviewEnabledBox" Checked="Settings_Changed" Unchecked="Settings_Changed" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="{loc:LocalizedText Key=FilePreview}"/>
                </Grid></Border>
                <Border Style="{StaticResource SettingsCard}"><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{loc:LocalizedText Key=BackgroundSearch}"/><TextBlock Text="{loc:LocalizedText Key=Search_BackgroundCompactHint}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
                    <ToggleButton x:Name="ResidentBox" Checked="Settings_Changed" Unchecked="Settings_Changed" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="{loc:LocalizedText Key=BackgroundSearch}"/>
                </Grid></Border>
                <Border Style="{StaticResource SettingsCard}"><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{loc:LocalizedText Key=StartAtLogin}"/><TextBlock Text="{loc:LocalizedText Key=Search_LoginCompactHint}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
                    <ToggleButton x:Name="StartupBox" Checked="Settings_Changed" Unchecked="Settings_Changed" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" AutomationProperties.Name="{loc:LocalizedText Key=StartAtLogin}"/>
                </Grid></Border>
                <Border Style="{StaticResource SettingsCard}"><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:LocalizedText Key=GlobalShortcut}" VerticalAlignment="Center"/>
                    <TextBox x:Name="HotkeyBox" TextChanged="Hotkey_Changed" LostFocus="Hotkey_LostFocus" Grid.Column="1" AutomationProperties.Name="{loc:LocalizedText Key=Search_GlobalShortcut}" Text="Alt+Space" Padding="12,8" Background="{DynamicResource Hover}" Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" PreviewKeyDown="Hotkey_KeyDown" ToolTip="{loc:LocalizedText Key=Shortcut_RecordHint}">
                        <TextBox.Template><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></TextBox.Template>
                    </TextBox>
                </Grid></Border>
                <Border Style="{StaticResource SettingsCard}"><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:LocalizedText Key=Tray_LeftClick}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <RadioButton x:Name="TraySearchOption" Checked="Settings_Changed" GroupName="TrayAction" Style="{StaticResource Segment}" Content="{loc:LocalizedText Key=Search_Palette}" AutomationProperties.Name="{loc:LocalizedText Key=Tray_OpenSearch}" IsChecked="True"/>
                        <RadioButton x:Name="TrayFilesOption" Checked="Settings_Changed" GroupName="TrayAction" Style="{StaticResource Segment}" Content="{loc:LocalizedText Key=FileManager}" AutomationProperties.Name="{loc:LocalizedText Key=Tray_OpenManager}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid></Border>
                <Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:LocalizedText Key=Category_Buttons}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{loc:LocalizedText Key=Category_Manage}" Click="Categories_Open"/>
                </Grid></Border>
                <Border Style="{StaticResource SettingsCard}"><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:LocalizedText Key=ResultOrder}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="{loc:LocalizedText Key=ResultOrder_Edit}" Click="Ranking_Click" ToolTip="{loc:LocalizedText Key=ResultOrder_SharedHint}"/>
                </Grid></Border>
                <Border Style="{StaticResource SettingsCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:LocalizedText Key=Search_HiddenResults}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{loc:LocalizedText Key=Search_ManageHidden}" Click="HiddenResults_Open"/>
                </Grid></Border>
                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="{loc:LocalizedText Key=Search_ManageIndex}" HorizontalAlignment="Left" Foreground="{DynamicResource Muted}" Click="ManageIndex_Click" ToolTip="{loc:LocalizedText Key=Search_ManageIndexHint}"/>
                </Grid>
                <TextBlock x:Name="SettingsStatus" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="10,6,10,0" FontSize="12"/>
                </StackPanel></ScrollViewer>
            </StackPanel>
            <Grid x:Name="HiddenResultsPanel" Visibility="Collapsed" Margin="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="&#xE72B;" FontFamily="Segoe Fluent Icons" Click="HiddenResults_Back" AutomationProperties.Name="{loc:LocalizedText Key=BackToSearchSettings}"/>
                    <TextBlock Grid.Column="1" Text="{loc:LocalizedText Key=Search_HiddenResults}" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="{loc:LocalizedText Key=RestoreAll}" Click="HiddenResults_RestoreAll"/>
                </Grid>
                <TextBlock Grid.Row="1" Text="{loc:LocalizedText Key=Search_HiddenHint}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="8,0,0,12"/>
                <ListBox Grid.Row="2" x:Name="HiddenResultsList" MaxHeight="360" BorderThickness="0" Background="Transparent" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="4,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Location}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}"/></StackPanel>
                        <Button Grid.Column="1" Content="{loc:LocalizedText Key=Restore}" Margin="12,0,0,0" Click="HiddenResults_Restore"/>
                    </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <StackPanel x:Name="RankingPanel" Visibility="Collapsed" Margin="4">
                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="&#xE72B;" FontFamily="Segoe Fluent Icons" Click="RankingBack_Click" AutomationProperties.Name="{loc:LocalizedText Key=BackToSearchSettings}"/>
                    <TextBlock Grid.Column="1" Text="{loc:LocalizedText Key=ResultOrder}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" Content="{loc:LocalizedText Key=Shortcut_RestoreDefaults}" Click="RankingReset_Click" Foreground="{DynamicResource Muted}"/>
                </Grid>
                <TextBlock Text="{loc:LocalizedText Key=ResultOrder_Hint}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="12,0,12,12"/>
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="8,4">
                    <ScrollViewer x:Name="RankingScroll" MaxHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowDrop="True" DragOver="Rank_DragOver" DragLeave="Rank_DragLeave" Drop="Rank_Drop">
                        <ItemsControl x:Name="RankingItems"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border x:Name="RankingRow" Style="{StaticResource RankRow}" AllowDrop="True" Focusable="True" PreviewMouseLeftButtonDown="Rank_MouseDown" PreviewMouseLeftButtonUp="Rank_MouseUp" LostMouseCapture="Rank_LostCapture" MouseMove="Rank_MouseMove" KeyDown="Rank_KeyDown" DragOver="Rank_DragOver" DragLeave="Rank_DragLeave" Drop="Rank_Drop" Cursor="SizeNS"><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE76F;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <ToggleButton Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource Switch}" VerticalAlignment="Center" Visibility="{Binding ExecutableToggleVisibility}" IsChecked="{Binding ExecutablesEnabled, Mode=TwoWay}" Checked="RankExecutable_Changed" Unchecked="RankExecutable_Changed" AutomationProperties.Name="{loc:LocalizedText Key=Search_StandaloneExecutables}" ToolTip="{loc:LocalizedText Key=Search_StandaloneExecutablesHint}"/>
                                <Border x:Name="RankDropIndicator" Grid.ColumnSpan="3" Height="2" Margin="6,0" CornerRadius="1" VerticalAlignment="Top" Background="{DynamicResource Accent}" Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid></Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="RankingStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="10,6,10,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
